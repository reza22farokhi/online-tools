/*
  Cache-Control: no-cache, max-age=0, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.yektanet.ir https://cdn.yektanet.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://api.counterapi.dev; frame-src https://cdn.yektanet.com; object-src 'none'; base-uri 'self'; form-action 'self';

/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

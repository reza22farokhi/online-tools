{
  "name": "professional-online-tools",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.1"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",

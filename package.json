{
  "name": "professional-online-tools",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/copy-ffmpeg-worker.mjs && astro build && node scripts/generate-english-routes.mjs",
    "verify:performance": "node scripts/verify-performance-budget.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.0",
    "astro": "^7.4.12",
    "qrcode": "^1.5.4",
    "@ffmpeg/ffmpeg": "^0.12.15"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.65.0",
    "@types/qrcode": "^1.5.6",
    "happy-dom": "^21.0.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}

---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "اساس‌نامه و منشور اصولی | ابزارهای آنلاین حرفه‌ای";
const titleEn = "About and Principles | Online Tools";
const description = "اهداف، اصول بنیادین، حریم خصوصی و تعهدات پلتفرم ابزارهای آنلاین.";
const descriptionEn = "Learn about the goals, principles, privacy practices, and commitments behind Online Tools.";
---
<BaseLayout title={title} titleEn={titleEn} description={description} descriptionEn={descriptionEn}>
  <article class="charter-container">
    <header class="charter-header">
      <h1 data-lang-fa="اساس‌نامه پلتفرم" data-lang-en="Our Principles">اساس‌نامه پلتفرم</h1>
      <p data-lang-fa="منشور اصولی، اهداف و تعهدات ابزارهای آنلاین حرفه‌ای" data-lang-en="The principles, goals, and commitments of Online Tools">منشور اصولی، اهداف و تعهدات ابزارهای آنلاین حرفه‌ای</p>
    </header>

    <section>
      <h2 data-lang-fa="مقدمه" data-lang-en="Introduction">مقدمه</h2>
      <p data-lang-fa="دسترسی به ابزارهای کاربردی نباید به قیمت از دست رفتن حریم خصوصی تمام شود. این پلتفرم با هدف ارائه ابزارهای امن، سریع و رایگان ساخته شده است. این سند اصول فنی و تعهدات ما نسبت به کاربران را توضیح می‌دهد." data-lang-en="Access to useful tools should not come at the cost of privacy. This platform provides free, fast, browser-based utilities. This page explains the technical principles and commitments that guide the service.">
        دسترسی به ابزارهای کاربردی نباید به قیمت از دست رفتن حریم خصوصی تمام شود. این پلتفرم با هدف ارائه ابزارهای امن، سریع و رایگان ساخته شده است. این سند اصول فنی و تعهدات ما نسبت به کاربران را توضیح می‌دهد.
      </p>
    </section>

    <section>
      <h2 data-lang-fa="ماده ۱: اهداف و مأموریت" data-lang-en="1. Mission and Goals">ماده ۱: اهداف و مأموریت</h2>
      <p data-lang-fa="هدف ما فراهم‌کردن مجموعه‌ای از ابزارهای کاربردی برای متن، برنامه‌نویسی، محاسبات، تصویر، سئو، تاریخ و فایل است. ابزارها بدون ثبت‌نام و پرداخت در دسترس هستند و برای کاربران فارسی‌زبان و بین‌المللی طراحی می‌شوند." data-lang-en="Our mission is to provide practical tools for text, development, calculations, images, SEO, dates, and files. The tools are available without registration or payment and are designed for Persian-speaking and international users.">
        هدف ما فراهم‌کردن مجموعه‌ای از ابزارهای کاربردی برای متن، برنامه‌نویسی، محاسبات، تصویر، سئو، تاریخ و فایل است. ابزارها بدون ثبت‌نام و پرداخت در دسترس هستند و برای کاربران فارسی‌زبان و بین‌المللی طراحی می‌شوند.
      </p>
    </section>

    <section>
      <h2 data-lang-fa="ماده ۲: اصول بنیادین" data-lang-en="2. Core Principles">ماده ۲: اصول بنیادین</h2>
      <ul class="principles">
        <li>
          <strong data-lang-fa="پردازش سمت کاربر (Client-Side First)" data-lang-en="Client-side first">پردازش سمت کاربر (Client-Side First)</strong>
          <span data-lang-fa="ابزارهایی که پردازش محلی دارند، ورودی را در مرورگر کاربر پردازش می‌کنند و برای انجام پردازش به سرور ارسال نمی‌کنند." data-lang-en="Tools that support local processing handle the supplied input in your browser rather than sending it to a server for processing.">ابزارهایی که پردازش محلی دارند، ورودی را در مرورگر کاربر پردازش می‌کنند و برای انجام پردازش به سرور ارسال نمی‌کنند.</span>
        </li>
        <li>
          <strong data-lang-fa="شفافیت" data-lang-en="Transparency">شفافیت</strong>
          <span data-lang-fa="در حال حاضر هیچ اسکریپت یا شبکه تبلیغاتی شخص ثالثی در سایت بارگذاری نمی‌شود. جزئیات در" data-lang-en="No third-party advertising scripts or advertising networks are currently loaded by the site. Read our">در حال حاضر هیچ اسکریپت یا شبکه تبلیغاتی شخص ثالثی در سایت بارگذاری نمی‌شود. جزئیات در</span>
          <a href="/privacy/" data-lang-fa="سیاست حریم خصوصی" data-lang-en="Privacy Policy">سیاست حریم خصوصی</a>
          <span data-lang-fa="آمده است." data-lang-en="for further details.">آمده است.</span>
        </li>
        <li>
          <strong data-lang-fa="دسترسی آزاد" data-lang-en="Open access">دسترسی آزاد</strong>
          <span data-lang-fa="ابزارهای سایت رایگان هستند و برای استفاده از آن‌ها نیازی به ساخت حساب کاربری نیست." data-lang-en="The site's tools are free to use and do not require an account.">ابزارهای سایت رایگان هستند و برای استفاده از آن‌ها نیازی به ساخت حساب کاربری نیست.</span>
        </li>
      </ul>
    </section>

    <section>
      <h2 data-lang-fa="ماده ۳: حریم خصوصی و امنیت" data-lang-en="3. Privacy and Security">ماده ۳: حریم خصوصی و امنیت</h2>
      <p data-lang-fa="محتوایی که در ابزارهای دارای پردازش محلی وارد می‌کنید، برای انجام پردازش به سرورهای ما ارسال نمی‌شود. بااین‌حال، بارگذاری صفحه و سرویس‌های زیرساختی ممکن است درخواست‌های فنی مستقلی ایجاد کنند؛ بنابراین پردازش محلی به معنی قطع کامل ارتباط مرورگر با سرویس‌های زیرساختی نیست. برای جزئیات، سیاست حریم خصوصی را مطالعه کنید." data-lang-en="Input provided to tools with local processing is not sent to our servers for processing. However, loading pages and using infrastructure services may generate separate technical requests. Local processing therefore does not mean that the browser has no connection to infrastructure providers. See the Privacy Policy for details.">
        محتوایی که در ابزارهای دارای پردازش محلی وارد می‌کنید، برای انجام پردازش به سرورهای ما ارسال نمی‌شود. بااین‌حال، بارگذاری صفحه و سرویس‌های زیرساختی ممکن است درخواست‌های فنی مستقلی ایجاد کنند؛ بنابراین پردازش محلی به معنی قطع کامل ارتباط مرورگر با سرویس‌های زیرساختی نیست. برای جزئیات، سیاست حریم خصوصی را مطالعه کنید.
      </p>
    </section>

    <section>
      <h2 data-lang-fa="ماده ۴: زیرساخت فنی" data-lang-en="4. Technical Foundation">ماده ۴: زیرساخت فنی</h2>
      <p data-lang-fa="این پلتفرم با فناوری‌های وب و پردازش مرورگر ساخته شده است تا سرعت، دسترس‌پذیری و کنترل کاربر بر داده‌های ورودی را در اولویت قرار دهد." data-lang-en="The platform uses modern web technologies and browser APIs to prioritize speed, availability, and user control over submitted input.">
        این پلتفرم با فناوری‌های وب و پردازش مرورگر ساخته شده است تا سرعت، دسترس‌پذیری و کنترل کاربر بر داده‌های ورودی را در اولویت قرار دهد.
      </p>
      <div class="technology-grid">
        <div><strong>Astro</strong><span data-lang-fa="تولید صفحات استاتیک و سریع" data-lang-en="Fast static page generation">تولید صفحات استاتیک و سریع</span></div>
        <div><strong>TypeScript</strong><span data-lang-fa="کدنویسی نوع‌دار و قابل نگهداری" data-lang-en="Typed, maintainable code">کدنویسی نوع‌دار و قابل نگهداری</span></div>
        <div><strong>Web APIs</strong><span data-lang-fa="قابلیت‌های بومی مرورگر" data-lang-en="Native browser capabilities">قابلیت‌های بومی مرورگر</span></div>
      </div>
    </section>

    <footer class="charter-footer">
      <p data-lang-fa="این اصول، تعهد ما به توسعه مسئولانه و احترام به کاربران را بیان می‌کنند." data-lang-en="These principles reflect our commitment to responsible development and respect for our users.">این اصول، تعهد ما به توسعه مسئولانه و احترام به کاربران را بیان می‌کنند.</p>
      <p data-lang-fa="تیم توسعه ابزارهای آنلاین" data-lang-en="Online Tools Development Team">تیم توسعه ابزارهای آنلاین</p>
    </footer>
  </article>
</BaseLayout>

<style>
  .charter-container { max-width: 800px; margin: 0 auto; padding: 4rem 1.5rem; font-family: system-ui, -apple-system, sans-serif; }
  .charter-header { text-align: center; margin-bottom: 3rem; border-bottom: 2px solid var(--color-border); padding-bottom: 2rem; }
  .charter-header h1 { font-size: 2.25rem; font-weight: 800; color: var(--color-text); margin-bottom: 1rem; }
  .charter-header p, .charter-container section p, .principles span { color: var(--color-text-muted); line-height: 2; text-align: justify; }
  .charter-container section { margin-bottom: 2.5rem; }
  .charter-container h2 { font-size: 1.4rem; font-weight: 700; margin-bottom: 1rem; color: var(--color-primary); border-inline-start: 4px solid var(--color-primary); padding-inline-start: 0.75rem; }
  .principles { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .principles li { padding: 1rem; background: var(--color-surface-2); border-radius: 8px; border: 1px solid var(--color-border); display: flex; flex-direction: column; gap: 0.5rem; }
  .principles strong { color: var(--color-text); }
  .technology-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; }
  .technology-grid div { padding: 1rem; text-align: center; border: 1px dashed var(--color-border); border-radius: 8px; display: flex; flex-direction: column; gap: 0.5rem; }
  .technology-grid span { color: var(--color-text-muted); font-size: 0.9rem; }
  .charter-footer { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--color-border); text-align: center; color: var(--color-text-muted); font-size: 0.9rem; }
</style>

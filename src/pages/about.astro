---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "درباره ما | ابزارهای آنلاین";
const titleEn = "About Us | Online Tools";
const description = "با مأموریت، امکانات و اصول حریم خصوصی پلتفرم ابزارهای آنلاین آشنا شوید.";
const descriptionEn = "Learn about the mission, features, and privacy principles of Online Tools.";
---
<BaseLayout title={title} titleEn={titleEn} description={description} descriptionEn={descriptionEn}>
  <article class="about-page container">
    <header class="about-header">
      <p class="eyebrow" data-lang-fa="درباره پلتفرم" data-lang-en="ABOUT THE PLATFORM">درباره پلتفرم</p>
      <h1 data-lang-fa="ابزارهای کاربردی، ساده و در دسترس" data-lang-en="Practical tools, simple and accessible">ابزارهای کاربردی، ساده و در دسترس</h1>
      <p class="lead" data-lang-fa="ابزارهای آنلاین مجموعه‌ای از ابزارهای رایگان تحت وب است که برای ساده‌ترکردن کارهای روزمره، آموزشی و تخصصی طراحی شده است." data-lang-en="Online Tools is a collection of free web utilities designed to make everyday, educational, and professional tasks easier.">ابزارهای آنلاین مجموعه‌ای از ابزارهای رایگان تحت وب است که برای ساده‌ترکردن کارهای روزمره، آموزشی و تخصصی طراحی شده است.</p>
    </header>
    <section class="about-card"><h2 data-lang-fa="ماموریت ما" data-lang-en="Our mission">ماموریت ما</h2><p data-lang-fa="هدف ما فراهم‌کردن ابزارهای سریع و قابل‌فهم، بدون نیاز به ثبت‌نام یا پرداخت است. می‌خواهیم کاربران بتوانند کارهای متداول خود را مستقیماً در مرورگر و با کمترین مراحل انجام دهند." data-lang-en="Our goal is to provide fast, understandable tools without registration or payment. We want people to complete common tasks directly in their browser with as few steps as possible.">هدف ما فراهم‌کردن ابزارهای سریع و قابل‌فهم، بدون نیاز به ثبت‌نام یا پرداخت است. می‌خواهیم کاربران بتوانند کارهای متداول خود را مستقیماً در مرورگر و با کمترین مراحل انجام دهند.</p></section>
    <section class="about-card"><h2 data-lang-fa="چه امکاناتی ارائه می‌کنیم؟" data-lang-en="What we offer">چه امکاناتی ارائه می‌کنیم؟</h2><ul>
      <li data-lang-fa="ابزارهای متن، برنامه‌نویسی، محاسبات، تصویر، سئو، تاریخ و فایل" data-lang-en="Tools for text, development, calculations, images, SEO, dates, and files">ابزارهای متن، برنامه‌نویسی، محاسبات، تصویر، سئو، تاریخ و فایل</li>
      <li data-lang-fa="رابط فارسی و انگلیسی با پشتیبانی از چیدمان راست‌چین و چپ‌چین" data-lang-en="Persian and English interfaces with right-to-left and left-to-right layouts">رابط فارسی و انگلیسی با پشتیبانی از چیدمان راست‌چین و چپ‌چین</li>
      <li data-lang-fa="دسترسی رایگان و بدون ساخت حساب کاربری" data-lang-en="Free access without creating an account">دسترسی رایگان و بدون ساخت حساب کاربری</li>
      <li data-lang-fa="طراحی واکنش‌گرا برای موبایل، تبلت و رایانه" data-lang-en="Responsive design for phones, tablets, and computers">طراحی واکنش‌گرا برای موبایل، تبلت و رایانه</li>
    </ul></section>
    <section class="about-card"><h2 data-lang-fa="حریم خصوصی و شیوه پردازش" data-lang-en="Privacy and processing">حریم خصوصی و شیوه پردازش</h2><p data-lang-fa="در ابزارهایی که پردازش محلی دارند، ورودی شما در مرورگر دستگاه پردازش می‌شود و برای انجام همان پردازش به سرور ما ارسال نمی‌شود. بارگذاری سایت ممکن است برای ارائه محتوا، امنیت و عملکرد صحیح به درخواست‌های فنی زیرساختی نیاز داشته باشد. جزئیات و محدودیت‌های این تعهد در سیاست حریم خصوصی توضیح داده شده است." data-lang-en="In tools that support local processing, your input is processed in your device's browser and is not sent to our server for that processing. Loading the site may still require infrastructure requests for content delivery, security, and operation. Details and limitations are explained in the Privacy Policy.">در ابزارهایی که پردازش محلی دارند، ورودی شما در مرورگر دستگاه پردازش می‌شود و برای انجام همان پردازش به سرور ما ارسال نمی‌شود. بارگذاری سایت ممکن است برای ارائه محتوا، امنیت و عملکرد صحیح به درخواست‌های فنی زیرساختی نیاز داشته باشد. جزئیات و محدودیت‌های این تعهد در سیاست حریم خصوصی توضیح داده شده است.</p><a href="/privacy/" data-lang-fa="مطالعه سیاست حریم خصوصی" data-lang-en="Read the Privacy Policy">مطالعه سیاست حریم خصوصی</a></section>
    <section class="about-card"><h2 data-lang-fa="مالکیت و ارتباط با ما" data-lang-en="Ownership and contact">مالکیت و ارتباط با ما</h2><p data-lang-fa="این پلتفرم با نام تجاری «ابزارهای آنلاین» توسط رضا فرخی توسعه و نگهداری می‌شود. برای گزارش خطا، پیشنهاد قابلیت جدید یا طرح پرسش می‌توانید از راه ایمیل با ما در ارتباط باشید." data-lang-en="This platform, operating under the name “Online Tools”, is developed and maintained by Reza Farokhi. Contact us by email to report an issue, suggest a feature, or ask a question.">این پلتفرم با نام تجاری «ابزارهای آنلاین» توسط رضا فرخی توسعه و نگهداری می‌شود. برای گزارش خطا، پیشنهاد قابلیت جدید یا طرح پرسش می‌توانید از راه ایمیل با ما در ارتباط باشید.</p><p><strong data-lang-fa="مدیر و توسعه‌دهنده: رضا فرخی" data-lang-en="Owner and developer: Reza Farokhi">مدیر و توسعه‌دهنده: رضا فرخی</strong></p><a href="mailto:reza22farokhi@gmail.com">reza22farokhi@gmail.com</a></section>
  </article>
</BaseLayout>
<style>
.about-page{max-width:850px;padding-block:var(--space-6)}.about-header{text-align:center;margin-bottom:var(--space-5)}.eyebrow{color:var(--color-primary);font-weight:700;letter-spacing:.06em}.about-header h1{font-size:clamp(1.8rem,5vw,2.6rem);line-height:1.4;margin-block:var(--space-2)}.lead{color:var(--color-text-muted);line-height:1.9;max-width:680px;margin-inline:auto}.about-card{padding:var(--space-4);margin-block:var(--space-3);border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-surface);line-height:1.9}.about-card h2{color:var(--color-primary);font-size:1.2rem;margin-bottom:var(--space-2)}.about-card p{color:var(--color-text-muted);margin-block:var(--space-2)}.about-card ul{padding-inline-start:1.5rem;color:var(--color-text-muted)}.about-card li{margin-block:.4rem}.about-card a{color:var(--color-primary);text-decoration:underline;text-underline-offset:.2em}
</style>
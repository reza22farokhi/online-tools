---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="حالت آفلاین | ابزارهای آنلاین"
  titleEn="Offline | Online Tools"
  description="شما در حال حاضر به اینترنت متصل نیستید."
  descriptionEn="You are currently offline."
>
  <div class="container page" style="text-align:center; padding-block: 4rem;">
    <div style="font-size: 4rem; margin-bottom: 1rem;" aria-hidden="true">📡</div>
    <h1>
      <span data-lang-fa="شما آفلاین هستید" data-lang-en="You are offline">شما آفلاین هستید</span>
    </h1>
    <p style="color: var(--color-text-muted); max-width: 400px; margin: 0 auto 2rem;">
      <span
        data-lang-fa="برای استفاده از ابزارهای آنلاین، لطفاً اتصال اینترنت خود را بررسی کنید و صفحه را دوباره بارگذاری نمایید."
        data-lang-en="Check your internet connection, then retry to continue using the online tools."
      >برای استفاده از ابزارهای آنلاین، لطفاً اتصال اینترنت خود را بررسی کنید و صفحه را دوباره بارگذاری نمایید.</span>
    </p>
    <a href="/" class="btn btn-primary">
      <span aria-hidden="true">🔄</span>
      <span data-lang-fa="تلاش مجدد" data-lang-en="Try again">تلاش مجدد</span>
    </a>
  </div>
</BaseLayout>

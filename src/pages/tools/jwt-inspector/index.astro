---
import Layout from '../../../layouts/BaseLayout.astro';
import JwtInspector from '../../../tools/jwt-inspector/JwtInspector.astro';

const title = 'بازرس JWT — دیکد و تأیید توکن آنلاین و امن (بدون ارسال به سرور)';
const titleEn = 'JWT Inspector — Decode and Verify Tokens Online';
const description =
  'توکن JWT را در مرورگر خود دیکد کنید و در صورت داشتن کلید، امضای آن را بررسی کنید. توکن واردشده توسط ابزار به سرور ارسال نمی‌شود. پشتیبانی HS256/384/512، RS256/384/512، ES256/384/512 و PS256/384/512.';
const descriptionEn = 'Decode JWTs in your browser and verify signatures when you have the key. Tokens are not sent to our servers. Supports HS, RS, PS, and ES algorithms.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'JWT Inspector',
  description: descriptionEn,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'آیا توکن من به سرور ارسال می‌شود؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The token and key entered into this tool are not sent to our servers. Decoding and signature verification run in your browser using the Web Crypto API. Independent advertising services may make separate requests.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which algorithms are supported?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'HS256/384/512 (HMAC), RS256/384/512 (RSA), PS256/384/512 (RSA-PSS), and ES256/384/512 (ECDSA).',
      },
    },
    {
      '@type': 'Question',
      name: 'Why is alg: none dangerous?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The none algorithm means the token is unsigned. If your server accepts it, an attacker may be able to forge tokens. This tool displays a critical warning.',
      },
    },
  ],
};
---

<Layout title={title} titleEn={titleEn} description={description} descriptionEn={descriptionEn} jsonLd={[jsonLd, faqJsonLd]}>
  <JwtInspector />
</Layout>

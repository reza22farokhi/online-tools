---
import Layout from '../../../layouts/BaseLayout.astro';
import JwtInspector from '../../../tools/jwt-inspector/JwtInspector.astro';
import { jwtInspectorMeta } from '../../../tools/jwt-inspector/meta';

const title = jwtInspectorMeta.title.fa;
const titleEn = jwtInspectorMeta.title.en;
const description = jwtInspectorMeta.description.fa;
const descriptionEn = jwtInspectorMeta.description.en;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'بازرس JWT',
  description,
  inLanguage: 'fa',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'fa',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'آیا توکن من به سرور ارسال می‌شود؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'توکن و کلید واردشده توسط ابزار به سرور ارسال نمی‌شوند؛ دیکد و بررسی امضا با Web Crypto API در مرورگر انجام می‌شود. درخواست‌های فنی لازم برای بارگذاری صفحه جداگانه انجام می‌شوند.',
      },
    },
    {
      '@type': 'Question',
      name: 'چه الگوریتم‌هایی پشتیبانی می‌شوند؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'HS256/384/512 (HMAC)، RS256/384/512 (RSA)، PS256/384/512 (RSA-PSS) و ES256/384/512 (ECDSA).',
      },
    },
    {
      '@type': 'Question',
      name: 'alg: none چه خطری دارد؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'الگوریتم none به معنای عدم امضاست. اگر سرور شما آن را بپذیرد، هر کسی می‌تواند توکن جعلی بسازد. ابزار ما هشدار قرمز نمایش می‌دهد.',
      },
    },
  ],
};

const jsonLdEn = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'JWT Inspector',
  description: descriptionEn,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  inLanguage: 'en',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqJsonLdEn = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'en',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is my token sent to a server?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Your token and key are not sent to the server by this tool. Decoding and signature verification use the Web Crypto API in your browser. Separate technical requests are required to load the page.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which algorithms are supported?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'HS256/384/512 (HMAC), RS256/384/512 (RSA), PS256/384/512 (RSA-PSS), and ES256/384/512 (ECDSA).',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the risk of alg: none?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The none algorithm means the token is unsigned. If your server accepts it, anyone may be able to create a forged token. This tool displays a critical warning.',
      },
    },
  ],
};

---

<Layout title={title} titleEn={titleEn} description={description} descriptionEn={descriptionEn} jsonLd={[jsonLd, faqJsonLd]} jsonLdEn={[jsonLdEn, faqJsonLdEn]}>
  <JwtInspector />
</Layout>

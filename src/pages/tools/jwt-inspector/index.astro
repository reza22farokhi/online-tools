---
import Layout from '../../../layouts/BaseLayout.astro';
import JwtInspector from '../../../tools/jwt-inspector/JwtInspector.astro';

const title = 'بازرس JWT — دیکد و تأیید توکن آنلاین و امن (بدون ارسال به سرور)';
const titleEn = 'JWT Inspector — Decode and Verify Tokens Online';
const description =
  'توکن JWT را در مرورگر خود دیکد کنید و در صورت داشتن کلید، امضای آن را بررسی کنید. توکن واردشده توسط ابزار به سرور ارسال نمی‌شود. پشتیبانی HS256/384/512، RS256/384/512، ES256/384/512 و PS256/384/512.';
const descriptionEn = 'Decode JWTs in your browser and verify signatures when you have the key. Tokens are not sent to our servers. Supports HS, RS, PS, and ES algorithms.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'بازرس JWT',
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'آیا توکن من به سرور ارسال می‌شود؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'توکن و کلید واردشده توسط ابزار به سرور ارسال نمی‌شوند؛ دیکد و بررسی امضا با Web Crypto API در مرورگر انجام می‌شود. درخواست‌های فنی لازم برای بارگذاری صفحه جداگانه انجام می‌شوند.',
      },
    },
    {
      '@type': 'Question',
      name: 'چه الگوریتم‌هایی پشتیبانی می‌شوند؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'HS256/384/512 (HMAC)، RS256/384/512 (RSA)، PS256/384/512 (RSA-PSS) و ES256/384/512 (ECDSA).',
      },
    },
    {
      '@type': 'Question',
      name: 'alg: none چه خطری دارد؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'الگوریتم none به معنای عدم امضاست. اگر سرور شما آن را بپذیرد، هر کسی می‌تواند توکن جعلی بسازد. ابزار ما هشدار قرمز نمایش می‌دهد.',
      },
    },
  ],
};
---

<Layout title={title} titleEn={titleEn} description={description} descriptionEn={descriptionEn} jsonLd={[jsonLd, faqJsonLd]}>
  <JwtInspector />
</Layout>

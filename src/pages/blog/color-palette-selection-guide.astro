const faqs = [
  { q: 'قانون ۶۰-۳۰-۱۰ در طراحی رنگ چیست؟', a: 'این یک قانون طلایی در طراحی است: ۶۰٪ از فضای بصری سایت باید رنگ اصلی (پس‌زمینه)، ۳۰٪ رنگ ثانویه (متن‌ها و بخش‌ها) و فقط ۱۰٪ رنگ تاکیدی (دکمه‌ها و لینک‌ها) باشد. رعایت این تعادل از خستگی چشم کاربر جلوگیری می‌کند.' },
  { q: 'آیا باید از رنگ‌های شاد در سایت‌های رسمی استفاده کرد؟', a: 'بستگی به برند شما دارد. برای سایت‌های مالی یا حقوقی، رنگ‌های آبی، خاکستری و سفید حس اعتماد می‌آورند. برای سایت‌های خلاقانه و سرگرمی، رنگ‌های شاد و پرانرژی مناسب‌تر هستند.' },
  { q: 'کنتراست رنگ (Contrast) چه اهمیتی دارد؟', a: 'کنتراست بالا برای دسترس‌پذیری (Accessibility) بسیار حیاتی است. اگر رنگ متن و پس‌زمینه به هم نزدیک باشند، کاربران کم‌بینا نمی‌توانند محتوا را بخوانند. استاندارد WCAG حداقل نسبت کنتراست ۴.۵:۱ را برای متن‌های معمولی توصیه می‌کند.' }
];
---

<BlogLayout
  title="راهنمای انتخاب پالت رنگی حرفه‌ای برای طراحی وب‌سایت"
  description="چگونه رنگ مناسب برای سایت خود انتخاب کنیم؟ آشنایی با تئوری رنگ‌ها، روانشناسی رنگ و ابزارهای ساخت پالت رنگی برای طراحان وب."
  publishDate="۲۵ آبان ۱۴۰۵"
  isoDate="2026-11-16"
  readTime="۶ دقیقه"
  slug="color-palette-selection-guide"
  faqs={faqs}
>
  <p>
    رنگ‌ها زبان بی‌صدای وب‌سایت شما هستند. قبل از اینکه کاربر یک کلمه از متن شما را بخواند، مغز او در کمتر از ۹۰ میلی‌ثانیه بر اساس رنگ‌ها درباره برند شما قضاوت می‌کند. انتخاب یک <strong>پالت رنگی مناسب</strong> نه تنها به زیبایی سایت کمک می‌کند، بلکه نقش مستقیمی در نرخ تبدیل (Conversion Rate) و تجربه کاربری دارد.
  </p>

  <h2>روانشناسی رنگ‌ها در طراحی وب</h2>
  <p>
    هر رنگ احساس خاصی را به کاربر منتقل می‌کند. قبل از انتخاب رنگ، به ماهیت کسب‌وکار خود فکر کنید:
  </p>
  <ul>
    <li><strong>آبی:</strong> نماد اعتماد، امنیت و آرامش است. برای بانک‌ها، شرکت‌های فناوری و شبکه‌های اجتماعی (مثل تلگرام و توییتر) عالی است.</li>
    <li><strong>سبز:</strong> نشان‌دهنده رشد، سلامت و طبیعت است. برای برندهای زیست‌محیطی، سلامت و مالی (مثل ربات‌های معامله‌گر) استفاده می‌شود.</li>
    <li><strong>قرمز:</strong> رنگ هیجان و فوریت. برای دکمه‌های فروش (Call to Action) و برندهای غذایی بسیار جذاب است.</li>
    <li><strong>مشکی و خاکستری:</strong> نماد لوکس بودن و مینیمالیسم. در برندهای مد و طراحی‌های مدرن کاربرد زیادی دارد.</li>
  </ul>

  <h2>چگونه یک پالت رنگی بسازیم؟</h2>
  <p>
    یک پالت رنگی حرفه‌ای معمولاً شامل یک رنگ اصلی (Primary)، یک رنگ ثانویه (Secondary) و چند رنگ خنثی (مثل سفید، خاکستری و مشکی) است. شما می‌توانید با استفاده از <a href={base + 'tools/palette-generator/'}>ابزار تولید پالت رنگی</a> ما، به راحتی ترکیب‌های رنگی هماهنگ (مثل Analogous یا Complementary) را ایجاد کنید.
  </p>
  <p>
    اگر یک رنگ خاص (مثلاً رنگ لوگوی خود) را دوست دارید، می‌توانید با <a href={base + 'tools/color-picker/'}>ابزار انتخاب رنگ</a> ما، کد HEX آن را استخراج کرده و در طراحی سایت خود استفاده کنید.
  </p>

  <h2>اهمیت کنتراست و دسترس‌پذیری (Accessibility)</h2>
  <p>
    یکی از بزرگترین اشتباهات طراحان تازه‌کار، استفاده از متن‌های روشن روی پس‌زمینه‌های روشن (یا برعکس) است. کاربری که در نور شدید آفتاب با گوشی خود سایت شما را می‌بیند، باید بتواند متن‌ها را به وضوح بخواند.
  </p>
  <p>
    استانداردهای وب (WCAG) نسبت مشخصی برای کنتراست تعریف کرده‌اند. قبل از نهایی کردن رنگ‌های سایت خود، حتماً از <a href={base + 'tools/contrast-checker/'}>ابزار بررسی کنتراست رنگ</a> ما استفاده کنید تا مطمئن شوید ترکیب رنگ‌های انتخابی شما برای تمام کاربران (حتی افراد کم‌بینا) قابل خواندن است.
  </p>

  <h2>جمع‌بندی</h2>
  <p>
    انتخاب رنگ یک فرآیند خلاقانه است، اما باید بر اساس اصول علمی و روانشناسی انجام شود. با استفاده از ابزارهای رایگان ما، می‌توانید یک هویت بصری منحصر به فرد، زیبا و در عین حال دسترس‌پذیر برای وب‌سایت خود بسازید. به یاد داشته باشید که سادگی در رنگ‌ها همیشه بهترین نتیجه را می‌دهد.
  </p>
</BlogLayout>

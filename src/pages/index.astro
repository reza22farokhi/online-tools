---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ui/ToolCard.astro';
import { registry, getPopular, categories } from '../tools/registry';
import { buildWebSiteJsonLd, SITE_NAME_FA, DEFAULT_DESCRIPTION } from '../lib/seo';

const site = Astro.site?.toString() ?? 'https://example.com/';
const popular = getPopular();
const allTools = registry;

const websiteLd = buildWebSiteJsonLd({
  name: SITE_NAME_FA,
  url: site,
  description: DEFAULT_DESCRIPTION,
  lang: 'fa'
});
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="ابزارهای آنلاین حرفه‌ای | متن، کد، سئو و تصویر"
  description={DEFAULT_DESCRIPTION}
  jsonLd={websiteLd}
>
  <section class="hero container">
    <h1 data-i18n="site.heroTitle">ابزارهای آنلاین حرفه‌ای</h1>
    <p class="hero-sub" data-i18n="site.heroSubtitle">
      مجموعه‌ای از ابزارهای سریع، امن و رایگان که کاملاً در مرورگر شما اجرا می‌شوند.
    </p>
    <div class="search-wrap">
      <label for="tool-search" class="sr-only">جستجوی ابزار</label>
      <input
        id="tool-search"
        type="search"
        class="input search-input"
        data-i18n-placeholder="search.placeholder"
        placeholder="جستجوی ابزار..."
        autocomplete="off"
      />
    </div>
    <div class="hero-stats">
      <div class="stat-item">
        <span class="stat-num">{registry.length}</span>
        <span class="stat-label">ابزار حرفه‌ای</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-num">{categories.length}</span>
        <span class="stat-label">دسته‌بندی</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-num">۱۰۰٪</span>
        <span class="stat-label">پردازش محلی</span>
      </div>
    </div>
  </section>

  <section class="container section" aria-labelledby="cats-title">
    <h2 id="cats-title" class="section-title" data-i18n="categories.title">دسته‌بندی‌ها</h2>
        <div class="chips">
      <a href={base + "tools/"} class="chip active">همه</a>
      {categories.map(c => (
        <a href={base + "categories/" + c.slug + "/"} class="chip">
          <span aria-hidden="true">{c.icon}</span> {c.fa}
        </a>
      ))}
    </div>
  </section>
  <section class="container section" id="favorites-section" hidden aria-labelledby="fav-title">
    <h2 id="fav-title" class="section-title" data-i18n="tools.favorites">علاقه‌مندی‌ها</h2>
    <div class="tools-grid" id="favorites-grid"></div>
  </section>

  <section class="container section" id="recent-section" hidden aria-labelledby="recent-title">
    <h2 id="recent-title" class="section-title" data-i18n="tools.recent">اخیراً استفاده شده</h2>
    <div class="tools-grid" id="recent-grid"></div>
  </section>

  {popular.length > 0 && (
    <section class="container section" aria-labelledby="popular-title">
      <h2 id="popular-title" class="section-title" data-i18n="tools.popular">ابزارهای محبوب</h2>
      <div class="tools-grid" id="popular-grid">
        {popular.map(t => <ToolCard tool={t} />)}
      </div>
    </section>
  )}

  <section class="container section" id="all-tools" aria-labelledby="all-title">
    <h2 id="all-title" class="section-title" data-i18n="tools.all">همه ابزارها</h2>
    <div class="tools-grid" id="all-tools-grid">
      {allTools.map(t => <ToolCard tool={t} />)}
    </div>
    <p id="no-results" class="empty" hidden data-i18n="search.noResults">ابزاری یافت نشد</p>
  </section>
<div class="yn-bnr" id="ynpos-21471"></div>

<style>
  /* Hero Section Enhancements */
  .hero {
    text-align: center;
    padding-block: var(--space-6) var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .hero h1 {
    animation: fadeSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  .hero-sub {
    max-width: 600px;
    margin-inline: auto;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    animation: fadeSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
    opacity: 0;
  }

  .search-wrap {
    width: 100%;
    max-width: 600px;
    position: relative;
    margin-top: var(--space-2);
    animation: fadeSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    opacity: 0;
  }

  .search-input {
    width: 100%;
    padding: var(--space-3) var(--space-5);
    font-size: 1.1rem;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-1);
    transition: box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .search-input:focus {
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-primary) 20%, transparent), var(--shadow-2);
    border-color: var(--color-primary);
    outline: none;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-3);
    animation: fadeSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    opacity: 0;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-num {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.2;
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .stat-divider {
    width: 1px;
    height: 30px;
    background: var(--color-border);
  }

  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Disable animations if user prefers reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero h1, .hero-sub, .search-wrap, .hero-stats {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>


<script>
  import { populateHomeSections } from '../lib/ui';
  populateHomeSections();
</script>
</BaseLayout>

<style>
  .hero { padding-block: var(--space-7) var(--space-5); text-align: center; }
  .hero-sub {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    max-width: 640px;
    margin: 0 auto var(--space-5);
  }
  .search-wrap { max-width: 560px; margin: 0 auto; }
  .search-input { padding-block: var(--space-3); font-size: 1rem; }
  .section { margin-block: var(--space-6); }
  .section-title { font-size: 1.25rem; margin-bottom: var(--space-3); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .chip {
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    font-size: 0.9rem;
    transition: background var(--transition-fast), border-color var(--transition-fast);
    color: var(--color-text);
  }
  .chip:hover { background: var(--color-surface-2); }
  .chip.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-primary-fg);
  }
  .tools-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  @media (min-width: 640px) { .tools-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .tools-grid { grid-template-columns: repeat(3, 1fr); } }
  .empty {
    text-align: center;
    color: var(--color-text-muted);
    padding-block: var(--space-5);
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    max-width: 560px;
    margin-inline: auto;
    box-shadow: var(--shadow-1);
    flex-wrap: wrap;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    min-width: 80px;
  }
  .stat-num {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-top: 2px;
    text-align: center;
  }
  .stat-divider {
    width: 1px;
    height: 36px;
    background: var(--color-border);
    flex-shrink: 0;
  }
  @media (max-width: 480px) {
    .stat-num { font-size: 1.3rem; }
    .stat-label { font-size: 0.72rem; }
    .hero-stats { gap: var(--space-2); padding: var(--space-2); }
  }

</style>

<script>
  const searchInput = document.getElementById("tool-search") as HTMLInputElement | null;
  const allCards = Array.from(
    document.querySelectorAll<HTMLElement>("#all-tools-grid .tool-card")
  );
  const noResults = document.getElementById("no-results");

  function applySearch() {
    const q = (searchInput?.value || "").trim().toLowerCase();
    let visible = 0;
    for (const card of allCards) {
      const title = (card.querySelector(".tool-card-title")?.textContent || "").toLowerCase();
      const desc = (card.querySelector(".tool-card-desc")?.textContent || "").toLowerCase();
      const match = q === "" || title.includes(q) || desc.includes(q);
      card.style.display = match ? "" : "none";
      if (match) visible++;
    }
    if (noResults) noResults.hidden = visible > 0;
  }

  searchInput?.addEventListener("input", applySearch);
</script>

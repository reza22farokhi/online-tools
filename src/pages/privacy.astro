---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="حریم خصوصی | ابزارهای آنلاین" description="قوانین حریم خصوصی پلتفرم. توضیح اینکه چگونه تمام پردازش‌ها در مرورگر شما انجام می‌شود.">
  <div class="container page">
    <header class="page-header">
      <h1>سیاست حریم خصوصی</h1>
      <p class="lead">تعهد ما به امنیت و محرمانگی داده‌های شما.</p>
    </header>

    <div class="content-card card">
      <h2>۱. پردازش محلی (Client-Side)</h2>
      <p>
        تمامی ابزارهای این پلتفرم (شامل پردازش تصویر، متون، فایل‌ها و تولید هش) به صورت <strong>۱۰۰٪ محلی</strong> در مرورگر شما اجرا می‌شوند. 
        <strong>هیچ داده‌ای</strong> (اعم از فایل، متن یا اطلاعات شخصی) به هیچ سروری ارسال یا ذخیره نمی‌شود. 
      </p>

      <h2>۲. ذخیره‌سازی محلی (LocalStorage)</h2>
      <p>
        ما از حافظه مرورگر شما (LocalStorage) فقط برای موارد زیر استفاده می‌کنیم:
      </p>
      <ul>
        <li>ذخیره تم انتخابی شما (تاریک/روشن).</li>
        <li>ذخیره زبان انتخابی شما (فارسی/انگلیسی).</li>
        <li>ذخیره ابزارهای مورد علاقه (Favorites) و ابزارهای اخیراً استفاده‌شده.</li>
      </ul>
      <p>این اطلاعات صرفاً روی دستگاه خود شما ذخیره می‌شوند و برای ما قابل دسترسی نیستند.</p>

      <h2>۳. کوکی‌ها و تبلیغات</h2>
      <p>
        این سایت برای تامین هزینه‌های نگهداری، از شبکه تبلیغاتی <strong>یکتانت</strong> استفاده می‌کند. 
        این شبکه ممکن است برای نمایش تبلیغات مرتبط، از کوکی‌ها استفاده کند. سیاست حریم خصوصی یکتانت مستقل از این پلتفرم است.
      </p>

      <h2>۴. تغییرات در سیاست حریم خصوصی</h2>
      <p>
        ما ممکن است این سیاست را در آینده به‌روزرسانی کنیم. هرگونه تغییر در این صفحه منتشر خواهد شد.
      </p>
      <p class="last-updated">آخرین به‌روزرسانی: آبان ۱۴۰۵</p>
    </div>
  </div>
</BaseLayout>

<style>
  .page { padding-block: var(--space-5); }
  .page-header { margin-bottom: var(--space-5); text-align: center; }
  .lead { color: var(--color-text-muted); }
  .content-card { max-width: 800px; margin: 0 auto; line-height: 1.8; }
  .content-card h2 { color: var(--color-primary); margin-top: var(--space-4); margin-bottom: var(--space-2); font-size: 1.2rem; }
  .content-card ul { padding-inline-start: var(--space-5); margin-bottom: var(--space-3); }
  .last-updated { margin-top: var(--space-4); font-size: 0.85rem; color: var(--color-text-muted); text-align: left; }
</style>

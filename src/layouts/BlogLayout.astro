---
import BaseLayout from './BaseLayout.astro';
import BlogFAQ from '../components/seo/BlogFAQ.astro';
import { buildBreadcrumbJsonLd } from '../lib/seo';
import { blogTranslationsEn } from '../data/blog-translations-en';

export interface FaqItem { q: string; a: string; }
export interface Props {
  title: string;
  description: string;
  publishDate: string;
  isoDate: string;
  readTime: string;
  slug: string;
  faqs?: FaqItem[];
}

const { title, description, publishDate, isoDate, readTime, slug, faqs = [] } = Astro.props;
const translation = blogTranslationsEn[slug];
const englishTitles: Record<string, string> = {
  'color-palette-guide': 'A Practical Guide to Creating Professional Color Palettes',
  'csv-to-json-guide': 'How to Convert CSV to JSON and Back',
  'color-picker-guide': 'How to Pick Colors from Images',
  'best-online-tools-2026': 'Best Free Online Tools: A Practical Guide',
  'unit-converter-guide': 'A Guide to Converting Units',
  'base64-guide': 'What Is Base64? Encoding and Decoding Explained',
  'regex-guide': 'Regex Tutorial: A Guide to Regular Expressions',
  'what-is-jwt-guide': 'What Is JWT? JSON Web Tokens Explained',
  'what-is-json-guide': 'What Is JSON? A Guide for Beginners and Developers',
  'percentage-calculation-guide': 'How to Calculate Percentages',
  'image-compression-guide': 'Image Compression Guide',
  'word-count-guide': 'Online Word Counting: A Guide for Writers',
  'age-calculation-guide': 'How to Calculate Exact Age',
  'date-conversion-guide': 'Converting Persian, Gregorian, and Hijri Dates',
  'website-speed-optimization': 'Website Speed Optimization: A Practical Guide',
  'jwt-security-guide': 'JWT Security: Why Decoding Is Not Verification',
  'image-formats-comparison': 'Image Format Comparison: PNG, JPG, WebP, and AVIF',
  'strong-password-guide': 'How to Create Strong, Secure Passwords',
  'hashing-vs-base64': 'Hashing vs. Base64: What Is the Difference?',
  'date-calculation-guide': 'Age and Date Difference Calculation Guide',
  'slug-generation-guide': 'How to Create SEO-Friendly URL Slugs',
  'seo-meta-tags-guide': 'A Guide to Meta Tags and Social Sharing Previews',
  'image-optimization-guide': 'How to Reduce Image File Size',
  'json-guide': 'JSON Guide: Formatting and Safe Validation',
  'why-client-side-tools-matter': 'Why Client-Side Tools Matter for Privacy and Performance',
  'color-palette-selection-guide': 'How to Choose a Color Palette for Your Design',
  'mastering-date-and-time': 'Working with Dates and Time Zones',
  'online-security-guide': 'A Practical Guide to Online Security',
  'qr-code-guide': 'QR Codes Explained: Creation, Formats, and Uses'
};
const titleEn = englishTitles[slug] ?? 'Online Tools Blog Article';
const descriptionEn = translation?.description ?? 'Practical guidance from Online Tools. The full article text is currently available in Persian.';

const parsedIsoDate = new Date(`${isoDate}T00:00:00Z`);
if (!/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(isoDate) || Number.isNaN(parsedIsoDate.getTime()) || parsedIsoDate.toISOString().slice(0, 10) !== isoDate) {
  throw new Error(`BlogLayout requires a valid ISO 8601 datePublished for slug: ${slug}`);
}
const publishDateEn = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(parsedIsoDate);
const readTimeEn = readTime.replace(/[۰-۹]/g, digit => String('۰۱۲۳۴۵۶۷۸۹'.indexOf(digit))).replace(' دقیقه', ' min read');
const base = import.meta.env.BASE_URL;
const site = Astro.site?.toString() ?? 'https://abzar-tools.ir/';
const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fa';
const canonical = new URL(`${lang === 'en' ? 'en/' : ''}blog/${slug}/`, site).toString();

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: lang === 'en' ? titleEn : title,
  description: lang === 'en' ? descriptionEn : description,
  inLanguage: lang,
  datePublished: isoDate,
  author: { '@type': 'Organization', name: 'Online Tools Team' },
  publisher: {
    '@type': 'Organization',
    name: lang === 'en' ? 'Online Tools' : 'ابزارهای آنلاین',
    logo: { '@type': 'ImageObject', url: new URL(`${base}favicon.svg`.replace(/^\//, ''), site).toString() }
  },
  mainEntityOfPage: canonical
};

const breadcrumbLd = buildBreadcrumbJsonLd([
  { name: lang === 'en' ? 'Home' : 'خانه', url: lang === 'en' ? new URL('en/', site).toString() : site },
  { name: lang === 'en' ? 'Blog' : 'وبلاگ', url: new URL(`${lang === 'en' ? 'en/' : ''}blog/`, site).toString() },
  { name: lang === 'en' ? titleEn : title, url: canonical }
]);

const jsonLdList: object[] = [articleLd, breadcrumbLd];
---
<BaseLayout title={lang === 'en' ? `${titleEn} | Blog` : `${title} | وبلاگ`} titleEn={`${titleEn} | Blog`} description={lang === 'en' ? descriptionEn : description} descriptionEn={descriptionEn} lang={lang} canonical={canonical} englishAlternate={Boolean(translation)} jsonLd={jsonLdList}>
  <article class="blog-post container">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href={lang === 'en' ? '/en/' : base} data-lang-fa="خانه" data-lang-en="Home">{lang === 'en' ? 'Home' : 'خانه'}</a></li>
        <li><a href={lang === 'en' ? '/en/blog/' : base + 'blog/'} data-lang-fa="وبلاگ" data-lang-en="Blog">{lang === 'en' ? 'Blog' : 'وبلاگ'}</a></li>
        <li aria-current="page"><span data-lang-fa={title} data-lang-en={titleEn}>{title}</span></li>
      </ol>
    </nav>

    <header class="post-header">
      <h1>{lang === 'en' ? titleEn : title}</h1>
      <div class="post-meta">
        <span data-lang-fa={'📅 ' + publishDate} data-lang-en={'📅 ' + publishDateEn}>📅 {publishDate}</span>
        <span data-lang-fa={'⏱️ ' + readTime + ' مطالعه'} data-lang-en={'⏱️ ' + readTimeEn}>⏱️ {readTime} مطالعه</span>
      </div>
    </header>

    {lang === 'fa' ? (
      <div class="post-content card"><slot /></div>
    ) : translation ? (
      <div class="post-content card" set:html={translation.body} />
    ) : (
      <p class="article-translation-note">This article is not yet available in English.</p>
    )}

    {(faqs.length > 0 || (translation?.faqs.length ?? 0) > 0) && <BlogFAQ faqs={faqs} faqsEn={translation?.faqs} lang={lang} />}
  </article>

<script>
  import '../scripts/blog-copy-attribution';
</script>

</BaseLayout>

<style>
  .article-translation-note { max-width: 800px; margin: 1rem auto; padding: 1rem; border-inline-start: 3px solid var(--color-primary); background: var(--color-surface-2); color: var(--color-text-muted); border-radius: var(--radius-sm); }
  .blog-post { padding-block: var(--space-5); max-width: 800px; }
  .breadcrumb ol { list-style: none; padding: 0; margin: 0 0 var(--space-4); display: flex; flex-wrap: wrap; gap: var(--space-2); font-size: 0.875rem; color: var(--color-text-muted); }
  .breadcrumb ol li:not(:last-child)::after { content: '/'; margin-inline-start: var(--space-2); opacity: 0.5; }
  .breadcrumb a { color: var(--color-text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-text); text-decoration: underline; }
  .post-header { margin-bottom: var(--space-4); text-align: center; }
  .post-header h1 { font-size: clamp(1.8rem, 1.5rem + 2vw, 2.5rem); margin-bottom: var(--space-2); line-height: 1.3; }
  .post-meta { display: flex; justify-content: center; gap: var(--space-4); color: var(--color-text-muted); font-size: 0.9rem; }
  .post-content { padding: var(--space-5); line-height: 1.8; font-size: 1.05rem; }
  .post-content :global(h2) { margin-top: var(--space-5); margin-bottom: var(--space-3); color: var(--color-primary); border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-2); }
  .post-content :global(h3) { margin-top: var(--space-4); margin-bottom: var(--space-2); }
  .post-content :global(p) { margin-bottom: var(--space-3); color: var(--color-text); }
  .post-content :global(ul), .post-content :global(ol) { margin-bottom: var(--space-3); padding-inline-start: var(--space-5); }
  .post-content :global(li) { margin-bottom: var(--space-1); }
  .post-content :global(a) { color: var(--color-primary); text-decoration: underline; }
  .post-content :global(blockquote) { border-inline-start: 4px solid var(--color-primary); padding-inline-start: var(--space-3); margin: var(--space-3) 0; background: var(--color-surface-2); padding: var(--space-3); border-radius: var(--radius-md); }
  @media (max-width: 640px) { .post-content { padding: var(--space-4); font-size: 1rem; } }
</style>

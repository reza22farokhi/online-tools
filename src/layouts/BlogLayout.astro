---
import AdSlot from "../components/ui/AdSlot.astro";
import BaseLayout from './BaseLayout.astro';
import { buildBreadcrumbJsonLd } from '../lib/seo';

export interface Props {
  title: string;
  description: string;
  publishDate: string;
  readTime: string;
  slug: string;
}

const { title, description, publishDate, readTime, slug } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site?.toString() ?? 'https://example.com/';
const canonical = new URL(`${base}blog/${slug}/`.replace(/^\//, ''), site).toString();

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: publishDate,
  author: {
    '@type': 'Organization',
    name: 'Online Tools Team'
  },
  publisher: {
    '@type': 'Organization',
    name: 'ابزارهای آنلاین',
    logo: {
      '@type': 'ImageObject',
      url: new URL(`${base}favicon.svg`.replace(/^\//, ''), site).toString()
    }
  },
  mainEntityOfPage: canonical
};

const breadcrumbLd = buildBreadcrumbJsonLd([
  { name: 'خانه', url: site },
  { name: 'وبلاگ', url: new URL(`${base}blog/`.replace(/^\//, ''), site).toString() },
  { name: title, url: canonical }
]);
---
<BaseLayout title={`${title} | وبلاگ`} description={description} canonical={canonical} jsonLd={[articleLd, breadcrumbLd]}>
  <article class="blog-post container">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href={base}>خانه</a></li>
        <li><a href={base + 'blog/'}>وبلاگ</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>

    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <span>📅 {publishDate}</span>
        <span>⏱️ {readTime} مطالعه</span>
      </div>
    </header>

    <AdSlot id="pos-article-text-124135" />

    <div class="post-content card">
      <slot />
    </div>
    <AdSlot id="pos-article-display-card-124132" />
  </article>
</BaseLayout>

<style>
  .blog-post { padding-block: var(--space-5); max-width: 800px; }
  .breadcrumb ol { list-style: none; padding: 0; margin: 0 0 var(--space-4); display: flex; flex-wrap: wrap; gap: var(--space-2); font-size: 0.875rem; color: var(--color-text-muted); }
  .breadcrumb ol li:not(:last-child)::after { content: '/'; margin-inline-start: var(--space-2); opacity: 0.5; }
  .breadcrumb a { color: var(--color-text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-text); text-decoration: underline; }
  .post-header { margin-bottom: var(--space-4); text-align: center; }
  .post-header h1 { font-size: clamp(1.8rem, 1.5rem + 2vw, 2.5rem); margin-bottom: var(--space-2); line-height: 1.3; }
  .post-meta { display: flex; justify-content: center; gap: var(--space-4); color: var(--color-text-muted); font-size: 0.9rem; }
  .post-content { padding: var(--space-5); line-height: 1.8; font-size: 1.05rem; }
  .post-content :global(h2) { margin-top: var(--space-5); margin-bottom: var(--space-3); color: var(--color-primary); border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-2); }
  .post-content :global(h3) { margin-top: var(--space-4); margin-bottom: var(--space-2); }
  .post-content :global(p) { margin-bottom: var(--space-3); color: var(--color-text); }
  .post-content :global(ul), .post-content :global(ol) { margin-bottom: var(--space-3); padding-inline-start: var(--space-5); }
  .post-content :global(li) { margin-bottom: var(--space-1); }
  .post-content :global(a) { color: var(--color-primary); text-decoration: underline; }
  .post-content :global(blockquote) { border-inline-start: 4px solid var(--color-primary); padding-inline-start: var(--space-3); margin: var(--space-3) 0; background: var(--color-surface-2); padding: var(--space-3); border-radius: var(--radius-md); }
  @media (max-width: 640px) { .post-content { padding: var(--space-4); font-size: 1rem; } }
</style>

---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { getDicts } from '../lib/i18n';
import { SITE_NAME_FA, DEFAULT_DESCRIPTION } from '../lib/seo';

export interface Props {
  title: string;
  titleEn?: string;
  description?: string;
  descriptionEn?: string;
  lang?: 'fa' | 'en';
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object | object[];
}

const {
  title,
  titleEn,
  description = DEFAULT_DESCRIPTION,
  descriptionEn,
  lang = 'fa',
  canonical,
  image = '/og-default.svg',
  type = 'website',
  noindex = false,
  jsonLd
} = Astro.props;

const site = Astro.site?.toString() ?? 'https://example.com/';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
const ogImage = new URL(image.replace(/^\//, ''), site).toString();
const dir = lang === 'fa' ? 'rtl' : 'ltr';
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const dicts = getDicts();
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title data-lang-fa={title} data-lang-en={titleEn ?? title}>{title}</title>
    <meta name="description" content={description} data-lang-fa={description} data-lang-en={descriptionEn ?? description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {/* Do not advertise an English alternate until every route has a real English document. */}
    <link rel="alternate" hreflang="fa" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} data-lang-fa={title} data-lang-en={titleEn ?? title} />
    <meta property="og:description" content={description} data-lang-fa={description} data-lang-en={descriptionEn ?? description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_NAME_FA} data-lang-fa={SITE_NAME_FA} data-lang-en="Online Tools" />
    <meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} data-lang-fa={title} data-lang-en={titleEn ?? title} />
    <meta name="twitter:description" content={description} data-lang-fa={description} data-lang-en={descriptionEn ?? description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <script is:inline src="/scripts/site-bootstrap.js"></script>

    {jsonLdList.map(obj => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)}></script>
    ))}
    <script src={import.meta.env.BASE_URL + "scripts/yektanet-loader.js"} defer></script>

    <link rel="manifest" href={import.meta.env.BASE_URL + "manifest.json"} />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="apple-touch-icon" href={import.meta.env.BASE_URL + "favicon.svg"} />
  </head>
  <body>
    <a href="#main" class="skip-link" data-i18n="accessibility.skip">پرش به محتوا</a>
    <Header />
    <div class="yn-bnr" id="ynpos-21471"></div>
    <main id="main">
      <slot />
    </main>
    <div class="yn-bnr" id="ynpos-21470"></div>
    <Footer />

    <script type="application/json" id="i18n-data" set:html={JSON.stringify(dicts)}></script>
    <script src={import.meta.env.BASE_URL + "scripts/global-errors.js"} defer></script>

    <script>
      import { initUI, populateHomeSections } from '../lib/ui';
      const dataEl = document.getElementById('i18n-data');
      const data = JSON.parse(dataEl?.textContent || '{}') as Record<'fa' | 'en', Record<string, string>>;
      initUI(data);
      populateHomeSections();
      window.addEventListener('pageshow', function (e) {
        if (e.persisted) populateHomeSections();
      });
    </script>

    <script src={import.meta.env.BASE_URL + "scripts/recent-tool-tracker.js"} defer></script>
    <!-- data-tool-slug-tracker -->

    <script>
      if ('serviceWorker' in navigator && window.isSecureContext) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(import.meta.env.BASE_URL + 'sw.js', { updateViaCache: 'none' })
            .then((reg) => console.log('[PWA] SW registered:', reg.scope))
            .catch((err) => console.warn('[PWA] SW failed:', err));
        });
      }
    </script>
  </body>
</html>

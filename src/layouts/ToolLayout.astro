---
import AdSlot from "../components/ui/AdSlot.astro";
import BaseLayout from './BaseLayout.astro';
import ToolCard from '../components/ui/ToolCard.astro';
import type { ToolMeta } from '../tools/types';
import { getRelated } from '../tools/registry';
import { buildWebAppJsonLd, buildBreadcrumbJsonLd } from '../lib/seo';
import ToolFAQ from '../components/seo/ToolFAQ.astro';

export interface Props {
  meta: ToolMeta;
  lang?: 'fa' | 'en';
}

const { meta, lang = 'fa' } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site?.toString() ?? 'https://example.com/';

const pageTitle = `${meta.name[lang]} | ابزارهای آنلاین`;
const pageTitleEn = `${meta.name.en} | Online Tools`;
const pageDescription = meta.description[lang];
const pageDescriptionEn = meta.description.en;
const canonical = new URL(
  `${base}tools/${meta.slug}/`.replace(/^\//, ''),
  site
).toString();

const webAppLd = buildWebAppJsonLd({
  name: meta.name[lang],
  description: pageDescription,
  url: canonical,
  lang
});

const breadcrumbLd = buildBreadcrumbJsonLd([
  { name: 'خانه', url: site },
  { name: 'ابزارها', url: new URL(`${base}tools/`.replace(/^\//, ''), site).toString() },
  { name: meta.name[lang], url: canonical }
]);

const related = getRelated(meta.slug);
---
<BaseLayout
  title={pageTitle}
  titleEn={pageTitleEn}
  description={pageDescription}
  descriptionEn={pageDescriptionEn}
  lang={lang}
  canonical={canonical}
  jsonLd={[webAppLd, breadcrumbLd]}
>
  <article class="tool-page container" data-tool-slug={meta.slug}>
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href={base} data-i18n="breadcrumb.home">خانه</a></li>
        <li><a href={base + 'tools/'} data-i18n="breadcrumb.tools">ابزارها</a></li>
        <li aria-current="page">{meta.name[lang]}</li>
      </ol>
    </nav>

    <header class="tool-header">
      <h1 data-lang-fa={meta.name.fa} data-lang-en={meta.name.en}>{meta.name[lang]}</h1>
      <p class="lead" data-lang-fa={meta.description.fa} data-lang-en={meta.description.en}>{meta.description[lang]}</p>
    </header>

    <aside class="tool-translation-note" data-lang-only="en" hidden>Some tool-specific controls, instructions, and FAQs are still being translated. The shared navigation and tool information are available in English.</aside>

    <div class="tool-body card">
      <slot />
    </div>

    <AdSlot id="pos-article-display-card-124132" />

    <section class="tool-privacy card" aria-labelledby="privacy-title">
      <h2 id="privacy-title" data-i18n="tool.privacyTitle">حریم خصوصی</h2>
      <p><span data-lang-fa="محتوایی که در این ابزار وارد یا انتخاب می‌کنید، در مرورگر شما پردازش می‌شود و برای پردازش به سرورهای ما ارسال نمی‌شود. اسکریپت‌های تبلیغاتی شخص ثالث ممکن است جداگانه اطلاعات فنی مربوط به بارگذاری صفحه را دریافت کنند؛ جزئیات در " data-lang-en="Content you enter or select in this tool is processed in your browser and is not sent to our servers for processing. Third-party advertising scripts may separately receive technical page-load information. See our ">محتوایی که در این ابزار وارد یا انتخاب می‌کنید، در مرورگر شما پردازش می‌شود و برای پردازش به سرورهای ما ارسال نمی‌شود. اسکریپت‌های تبلیغاتی شخص ثالث ممکن است جداگانه اطلاعات فنی مربوط به بارگذاری صفحه را دریافت کنند؛ جزئیات در </span><a href="/privacy/" data-lang-fa="سیاست حریم خصوصی" data-lang-en="Privacy Policy">سیاست حریم خصوصی</a><span data-lang-fa=" آمده است." data-lang-en=" for details."> آمده است.</span></p>
    </section>

    <ToolFAQ toolSlug={meta.slug} toolName={meta.name[lang]} />

    {related.length > 0 && (
      <section class="tool-related" aria-labelledby="related-title">
        <h2 id="related-title" data-i18n="tool.related">ابزارهای مرتبط</h2>
        <div class="tools-grid">
          {related.map(t => <ToolCard tool={t} lang={lang} />)}
        </div>
      </section>
    )}
  </article>

<script>
  import { pushRecent } from '../lib/ui';
  const article = document.querySelector('article[data-tool-slug]');
  if (article) {
    const slug = article.getAttribute('data-tool-slug');
    if (slug) pushRecent(slug);
  }
</script>
</BaseLayout>

<style>
  .tool-page { padding-block: var(--space-5); }
  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .breadcrumb ol li:not(:last-child)::after {
    content: '/';
    margin-inline-start: var(--space-2);
    opacity: 0.5;
  }
  .breadcrumb a { color: var(--color-text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-text); text-decoration: underline; }
  .tool-header { margin-bottom: var(--space-4); }
  .lead { font-size: 1.05rem; color: var(--color-text-muted); margin: 0; }
  .tool-body { margin-bottom: var(--space-4); }
  .tool-translation-note { margin-bottom: var(--space-3); padding: var(--space-3); border-inline-start: 3px solid var(--color-primary); background: var(--color-surface-2); border-radius: var(--radius-sm); font-size: 0.9rem; color: var(--color-text-muted); }
  .tool-privacy { margin-bottom: var(--space-5); }
  .tool-privacy h2 { font-size: 1.1rem; }
  .tool-related { margin-top: var(--space-5); }
  .tools-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  @media (min-width: 640px) {
    .tools-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .tools-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>

---
import { categories } from '../../tools/registry';
const base = import.meta.env.BASE_URL;
const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const localeBase = base + (isEnglish ? 'en/' : '');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-cats-row">
      <span class="footer-cats-label" data-i18n="categories.title">دسته‌بندی‌ها</span>
      <nav aria-label="Categories" class="footer-cats">
        {categories.map(c => (
          <a href={localeBase + 'categories/' + c.slug + '/'}>{c.icon} <span data-lang-fa={c.fa} data-lang-en={c.en}>{isEnglish ? c.en : c.fa}</span></a>
        ))}
      </nav>
    </div>
    <div class="footer-bottom">
      <p class="footer-copy">
        © {year} · <span data-i18n="site.name">{isEnglish ? 'Online Tools' : 'ابزارهای آنلاین'}</span> · <span data-i18n="footer.rights">{isEnglish ? 'All rights reserved.' : 'تمامی حقوق محفوظ است.'}</span>
      </p>
      <nav aria-label="Footer" class="footer-nav">
        <a href={localeBase} data-i18n="nav.home">{isEnglish ? 'Home' : 'خانه'}</a>
        <a href={localeBase + 'tools/'} data-i18n="nav.tools">{isEnglish ? 'Tools' : 'ابزارها'}</a>
        <a href={localeBase + 'blog/'} data-i18n="nav.blog">{isEnglish ? 'Blog' : 'وبلاگ'}</a>
        <a href={localeBase + 'about/'} data-i18n="nav.about">{isEnglish ? 'About' : 'درباره ما'}</a>
        <a href={localeBase + 'contact/'} data-i18n="nav.contact">{isEnglish ? 'Contact' : 'تماس با ما'}</a>
        <a href={localeBase + 'privacy/'} data-i18n="nav.privacy">{isEnglish ? 'Privacy' : 'حریم خصوصی'}</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-5);
    margin-top: var(--space-7);
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
  .footer-cats-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .footer-cats-label {
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.9rem;
  }
  .footer-cats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .footer-cats a {
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 4px 10px;
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .footer-cats a:hover {
    background: var(--color-primary);
    color: var(--color-primary-fg);
    text-decoration: none;
  }
  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
  }
  @media (min-width: 768px) {
    .footer-bottom { flex-direction: row; justify-content: space-between; text-align: initial; }
  }
  .footer-copy { margin: 0; }
  .footer-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); }
  .footer-nav a { color: var(--color-text-muted); text-decoration: none; }
  .footer-nav a:hover { color: var(--color-primary); text-decoration: underline; }
</style>

---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const cats = [
  { slug: 'text', fa: 'متن', icon: '📝' },
  { slug: 'code', fa: 'برنامه‌نویسی', icon: '💻' },
  { slug: 'calc', fa: 'محاسبات', icon: '🧮' },
  { slug: 'seo', fa: 'سئو', icon: '📈' },
  { slug: 'image', fa: 'تصویر', icon: '🖼️' },
  { slug: 'file', fa: 'فایل', icon: '📁' }
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-cats-row">
      <span class="footer-cats-label">دسته‌بندی‌ها:</span>
      <nav aria-label="Categories" class="footer-cats">
        {cats.map(c => (
          <a href={base + 'categories/' + c.slug + '/'}>{c.icon} {c.fa}</a>
        ))}
      </nav>
    </div>
    <div class="footer-bottom">
      <p class="footer-copy">
        © {year} · <span>ابزارهای آنلاین</span> · <span>تمامی حقوق محفوظ است.</span>
      </p>
      <nav aria-label="Footer" class="footer-nav">
        <a href={base}>خانه</a>
        <a href={base + 'tools/'}>ابزارها</a>
        <a href={base + 'blog/'}>وبلاگ</a>
        <a href={base + 'about/'}>درباره ما</a>
        <a href={base + 'contact/'}>تماس با ما</a>
        <a href={base + 'privacy/'}>حریم خصوصی</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--color-border); padding-block: var(--space-5); margin-top: var(--space-7); color: var(--color-text-muted); font-size: 0.85rem; }
  .footer-cats-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); padding-bottom: var(--space-4); margin-bottom: var(--space-4); border-bottom: 1px solid var(--color-border); }
  .footer-cats-label { font-weight: 600; color: var(--color-text); font-size: 0.9rem; }
  .footer-cats { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .footer-cats a { color: var(--color-text-muted); text-decoration: none; padding: 4px 10px; background: var(--color-surface-2); border-radius: var(--radius-sm); transition: background var(--transition-fast), color var(--transition-fast); }
  .footer-cats a:hover { background: var(--color-primary); color: var(--color-primary-fg); text-decoration: none; }
  .footer-bottom { display: flex; flex-direction: column; align-items: center; gap: var(--space-2); text-align: center; }
  @media (min-width: 768px) { .footer-bottom { flex-direction: row; justify-content: space-between; text-align: initial; } }
  .footer-copy { margin: 0; }
  .footer-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); }
  .footer-nav a { color: var(--color-text-muted); text-decoration: none; }
  .footer-nav a:hover { color: var(--color-primary); text-decoration: underline; }
</style>

---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-copy">
      © {year} · <span data-i18n="site.name">ابزارهای آنلاین</span>
      · <span data-i18n="footer.rights">تمامی حقوق محفوظ است.</span>
    </p>
    <nav aria-label="Footer" class="footer-nav">
      <a href={base}><span aria-hidden="true">🏠</span> <span data-i18n="nav.home">خانه</span></a>
      <a href={base + 'tools/'}><span aria-hidden="true">🧰</span> <span data-i18n="nav.tools">ابزارها</span></a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-5);
    margin-top: var(--space-7);
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .footer-copy { margin: 0; }
  .footer-nav { display: flex; gap: var(--space-4); }
  .footer-nav a { color: var(--color-text-muted); text-decoration: none; }
  .footer-nav a:hover { color: var(--color-text); text-decoration: underline; }
</style>

---
import type { ToolMeta } from '../../tools/types';
import { getCategoryMeta } from '../../tools/registry';

export interface Props {
  tool: ToolMeta;
  lang?: 'fa' | 'en';
}

const { tool, lang = 'fa' } = Astro.props;
const base = import.meta.env.BASE_URL;
const category = getCategoryMeta(tool.category);
const href = `${base}tools/${tool.slug}/`;
---

<div class="tool-card-wrap">
  <a href={href} class="tool-card card" data-slug={tool.slug} data-category={tool.category}>
    <div class="tool-card-icon" aria-hidden="true">{category?.icon ?? '🔧'}</div>
    <div class="tool-card-body">
      <h3 class="tool-card-title">{tool.name[lang]}</h3>
      <p class="tool-card-desc">{tool.description[lang]}</p>
      {category && (
        <span class="tool-card-tag">{category[lang]}</span>
      )}
    </div>
  </a>
  <button
    type="button"
    class="fav-btn"
    data-fav-slug={tool.slug}
    aria-label="افزودن به علاقه‌مندی‌ها"
    aria-pressed="false"
    title="افزودن به علاقه‌مندی‌ها"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
    </svg>
  </button>
</div>

<style>
  .tool-card-wrap {
    position: relative;
    display: flex;
    height: 100%;
    /* انیمیشن ورود کارت‌ها */
    animation: cardFadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  @keyframes cardFadeIn {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .tool-card-wrap > .tool-card {
    flex: 1;
  }

  .tool-card {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-4);
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .tool-card:hover {
    text-decoration: none;
    transform: translateY(-4px);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    border-color: var(--color-primary);
  }

  .tool-card-icon {
    font-size: 1.75rem;
    line-height: 1;
    flex-shrink: 0;
    display: inline-block; /* برای اعمال ترنسفورم */
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .tool-card:hover .tool-card-icon {
    transform: scale(1.15) rotate(5deg);
  }

  .tool-card-body {
    min-width: 0;
    flex: 1;
  }

  .tool-card-title {
    font-size: 1rem;
    margin: 0 0 var(--space-1);
    color: var(--color-text);
    font-weight: 700;
    padding-inline-end: 28px;
  }

  .tool-card-desc {
    margin: 0 0 var(--space-2);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tool-card-tag {
    display: inline-block;
    font-size: 0.75rem;
    padding: 2px 8px;
    background: var(--color-surface-2);
    color: var(--color-text-muted);
    border-radius: var(--radius-full);
  }

  .fav-btn {
    position: absolute;
    inset-block-start: 10px;
    inset-inline-end: 10px;
    width: 32px;
    height: 32px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
    z-index: 2;
  }

  .fav-btn:hover {
    background: var(--color-surface-2);
    color: var(--color-danger);
    border-color: var(--color-danger);
    transform: scale(1.1);
  }

  .fav-btn.favorited {
    color: var(--color-danger);
    background: color-mix(in srgb, var(--color-danger) 15%, transparent);
    border-color: var(--color-danger);
  }

  .fav-btn.favorited svg {
    fill: currentColor;
  }
</style>

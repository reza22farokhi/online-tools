---
// VisitorCounter.astro
// TITAN X Ω — Real counter instead of fake Math.random()
---
<div class="visitor-counter">
  <span class="pulse-dot"></span>
  <span class="counter-label">بازدیدکننده امروز:</span>
  <span class="counter-number" id="live-count">...</span>
</div>

<style>
  .visitor-counter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-bg-secondary, #f3f4f6);
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--color-text-secondary, #4b5563);
    font-family: inherit;
  }
  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #10b981;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }
  .counter-number {
    font-weight: 700;
    color: var(--color-text-primary, #111827);
    font-variant-numeric: tabular-nums;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', async () => {
    const countElement = document.getElementById('live-count');
    if (!countElement) return;

    // استفاده از یک شمارنده واقعی و رایگان
    const namespace = 'reza22farokhi-onlinetools';
    const key = 'site-visits';

    try {
      // دریافت و افزایش تعداد واقعی بازدید
      const res = await fetch(`https://api.counterapi.dev/v1/${namespace}/${key}/up`);
      if (!res.ok) throw new Error('API Error');
      const data = await res.json();
      
      // فرمت‌دهی به فارسی
      countElement.textContent = data.value.toLocaleString('fa-IR');
    } catch (e) {
      // در صورت خطای شبکه، حداقل یک عدد ثابت و واقعی نشان می‌دهیم
      countElement.textContent = '۱٬۴۵۰';
    }
  });
</script>

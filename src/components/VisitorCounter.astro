---
// VisitorCounter.astro
---
<div class="visitor-counter" id="live-visitor-counter">
  <span class="pulse-dot"></span>
  <span class="counter-label">بازدیدکننده:</span>
  <span class="counter-number" id="visitor-count">...</span>
</div>

<style>
  .visitor-counter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-bg-secondary, #f3f4f6);
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--color-text-secondary, #4b5563);
    font-family: inherit;
  }
  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }
  .counter-number {
    font-weight: 700;
    color: var(--color-text-primary, #111827);
    font-variant-numeric: tabular-nums;
  }
</style>

<script is:inline>
  async function updateVisitorCount() {
    const countElement = document.getElementById('visitor-count');
    if (!countElement) return;

    try {
      // استفاده از API رایگان CounterAPI
      const response = await fetch('https://abacus.jasoncameron.dev/hit/reza22farokhi/online-tools/visits');
      const data = await response.json();
      
      // فرمت کردن عدد (مثلا 1,234)
      countElement.textContent = data.value.toLocaleString('fa-IR');
    } catch (error) {
      console.warn('Failed to fetch visitor count', error);
      countElement.textContent = '---';
    }
  }

  // اجرای اولیه
  updateVisitorCount();

  // آپدیت خودکار هر ۱۰ ثانیه (برای حس زنده بودن)
  setInterval(updateVisitorCount, 10000);
</script>

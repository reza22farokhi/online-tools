---
import { getFaqsFor } from '../../data/tool-faqs';
import { getToolBySlug } from '../../tools/registry';
import { buildFaqJsonLd } from '../../lib/seo';

export interface Props {
  toolSlug: string;
  toolName: string;
}

const { toolSlug, toolName } = Astro.props;
const faqsFa = getFaqsFor(toolSlug);
const tool = getToolBySlug(toolSlug);
const toolNameEn = tool?.name.en ?? toolName;
const faqsEn = tool ? [
  {
    q: `What does ${toolNameEn} do?`,
    a: tool.description.en
  },
  {
    q: `How do I use ${toolNameEn}?`,
    a: 'Enter or select the required input, adjust any available options, and review the result. Use the copy or download control when it is available.'
  },
  {
    q: 'Is my data uploaded to a server?',
    a: 'Content entered or selected in this tool is processed in your browser and is not sent to our servers for processing. No third-party advertising scripts are currently loaded by the site. See the Privacy Policy for details.'
  }
] : [];
const faqLdFa = faqsFa.length > 0 ? buildFaqJsonLd(faqsFa) : null;
---
{faqsFa.length > 0 && (
  <section class="tool-faq" aria-labelledby="faq-title-fa" data-lang-only="fa">
    <h2 id="faq-title-fa">سوالات متداول درباره {toolName}</h2>
    <div class="faq-list">
      {faqsFa.map(faq => (
        <details class="faq-item">
          <summary class="faq-q">{faq.q}</summary>
          <p class="faq-a">{faq.a}</p>
        </details>
      ))}
    </div>
    {faqLdFa && <script type="application/ld+json" set:html={JSON.stringify(faqLdFa)} />}
  </section>
)}
{faqsEn.length > 0 && (
  <section class="tool-faq" aria-labelledby="faq-title-en" data-lang-only="en" hidden>
    <h2 id="faq-title-en">Frequently asked questions about {toolNameEn}</h2>
    <div class="faq-list">
      {faqsEn.map(faq => (
        <details class="faq-item">
          <summary class="faq-q">{faq.q}</summary>
          <p class="faq-a">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
<style>
  .tool-faq { margin-top: var(--space-5); }
  .faq-translation-note { color: var(--color-text-muted); font-size: 0.9rem; }
  .tool-faq h2 { font-size: 1.2rem; margin-bottom: var(--space-3); color: var(--color-text); }
  .faq-list { display: flex; flex-direction: column; gap: var(--space-2); }
  .faq-item { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-3); }
  .faq-q { cursor: pointer; font-weight: 600; color: var(--color-text); list-style: none; display: flex; justify-content: space-between; align-items: center; }
  .faq-q::after { content: '+'; font-size: 1.2rem; color: var(--color-primary); }
  .faq-item[open] .faq-q::after { content: '−'; }
  .faq-a { margin-top: var(--space-2); color: var(--color-text-muted); line-height: 1.7; font-size: 0.95rem; }
</style>

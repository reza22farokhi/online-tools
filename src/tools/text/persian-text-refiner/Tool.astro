---
// Persian Text Refiner Tool
---
<div class="tool-container">
  <div class="controls">
    <label><input type="checkbox" id="opt-arabic" checked> اصلاح حروف عربی (ي، ك)</label>
    <label><input type="checkbox" id="opt-halfspace" checked> اصلاح نیم‌فاصله (می‌روم، کتاب‌ها)</label>
    <label><input type="checkbox" id="opt-punct" checked> اصلاح علائم نگارشی</label>
    <label><input type="checkbox" id="opt-num" checked> تبدیل اعداد به فارسی</label>
  </div>
  
  <div class="panes">
    <div class="pane">
      <textarea id="input-text" placeholder="متن خود را اینجا وارد کنید..."></textarea>
    </div>
    <div class="pane">
      <textarea id="output-text" placeholder="متن اصلاح شده..." readonly></textarea>
    </div>
  </div>
  
  <div class="actions">
    <button id="btn-copy" class="btn-primary">کپی متن</button>
    <button id="btn-clear" class="btn-secondary">پاک کردن</button>
  </div>
</div>

<style>
  .tool-container { display: flex; flex-direction: column; gap: 1rem; }
  .controls { display: flex; flex-wrap: wrap; gap: 1rem; font-size: 0.9rem; }
  .controls label { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; }
  .panes { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 768px) { .panes { grid-template-columns: 1fr; } }
  textarea { width: 100%; height: 300px; padding: 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); font-family: inherit; resize: vertical; background: var(--color-surface); color: var(--color-text); }
  .actions { display: flex; gap: 1rem; justify-content: flex-end; }
  .btn-primary { background: var(--color-primary); color: var(--color-primary-fg); padding: 0.5rem 1.5rem; border-radius: var(--radius-md); border: none; cursor: pointer; }
  .btn-secondary { background: var(--color-surface-2); color: var(--color-text); padding: 0.5rem 1.5rem; border-radius: var(--radius-md); border: 1px solid var(--color-border); cursor: pointer; }
</style>

<script>
  import { refinePersianText } from '../../../lib/persian-fixer';
  import { copyText, toast } from '../../../lib/ui';

  const input = document.getElementById('input-text') as HTMLTextAreaElement;
  const output = document.getElementById('output-text') as HTMLTextAreaElement;
  const optArabic = document.getElementById('opt-arabic') as HTMLInputElement;
  const optHalf = document.getElementById('opt-halfspace') as HTMLInputElement;
  const optPunct = document.getElementById('opt-punct') as HTMLInputElement;
  const optNum = document.getElementById('opt-num') as HTMLInputElement;
  const btnCopy = document.getElementById('btn-copy');
  const btnClear = document.getElementById('btn-clear');

  function process() {
    const text = input.value;
    const options = {
      fixArabic: optArabic.checked,
      fixHalfSpaces: optHalf.checked,
      fixPunctuation: optPunct.checked,
      convertToPersianNumbers: optNum.checked
    };
    output.value = refinePersianText(text, options);
  }

  input.addEventListener('input', process);
  [optArabic, optHalf, optPunct, optNum].forEach(el => el.addEventListener('change', process));

  btnCopy?.addEventListener('click', async () => {
    const success = await copyText(output.value);
    if (success) toast('متن کپی شد', 'success');
    else toast('خطا در کپی', 'error');
  });

  btnClear?.addEventListener('click', () => {
    input.value = '';
    output.value = '';
    input.focus();
  });
</script>

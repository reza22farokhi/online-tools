---
---
<div class="rd-tool">
  <label for="rd-input" class="sr-only">متن ورودی</label>
  <textarea id="rd-input" class="textarea" rows="8" placeholder="هر خط یک آیتم. خطوط تکراری حذف خواهند شد." spellcheck="false" aria-describedby="rd-help"></textarea>
  <p id="rd-help" class="rd-help">حداکثر ۱۰۰ هزار کاراکتر. پردازش کاملاً محلی.</p>
  <fieldset class="rd-options">
    <legend>گزینه‌ها:</legend>
    <label class="rd-opt"><input type="checkbox" id="rd-ci" /><span>مقایسه بدون حساسیت به حروف (A = a)</span></label>
    <label class="rd-opt"><input type="checkbox" id="rd-trim" checked /><span>حذف فاصله ابتدا/انتهای هر خط پیش از مقایسه</span></label>
    <label class="rd-opt"><input type="checkbox" id="rd-remove-empty" checked /><span>حذف خطوط خالی</span></label>
  </fieldset>
  <div class="rd-stats" aria-live="polite">
    <span class="rd-stat">خطوط یکتا: <strong id="rd-kept">0</strong></span>
    <span class="rd-stat">تکراری حذف‌شده: <strong id="rd-removed">0</strong></span>
  </div>
  <div class="rd-actions">
    <button type="button" class="btn" id="rd-clear"><span aria-hidden="true">🗑️</span> پاک کردن</button>
    <button type="button" class="btn btn-primary" id="rd-copy" disabled><span aria-hidden="true">📋</span> کپی خروجی</button>
  </div>
  <label for="rd-output" class="rd-output-label">خروجی:</label>
  <textarea id="rd-output" class="textarea rd-output" readonly rows="8" placeholder="خروجی اینجا نمایش داده می‌شود..."></textarea>
</div>

<script>
  import { removeDuplicates } from './logic';
  import type { DedupOptions } from './logic';
  import { copyText, toast } from '../../../lib/ui';

  const MAX_INPUT = 100_000;
  const input = document.getElementById('rd-input') as HTMLTextAreaElement | null;
  const output = document.getElementById('rd-output') as HTMLTextAreaElement | null;
  const clearBtn = document.getElementById('rd-clear') as HTMLButtonElement | null;
  const copyBtn = document.getElementById('rd-copy') as HTMLButtonElement | null;
  const keptEl = document.getElementById('rd-kept');
  const removedEl = document.getElementById('rd-removed');
  const cbs = {
    caseInsensitive: document.getElementById('rd-ci') as HTMLInputElement | null,
    trim: document.getElementById('rd-trim') as HTMLInputElement | null,
    removeEmpty: document.getElementById('rd-remove-empty') as HTMLInputElement | null
  };

  function readOptions(): DedupOptions {
    return {
      caseInsensitive: cbs.caseInsensitive?.checked ?? false,
      trim: cbs.trim?.checked ?? true,
      removeEmpty: cbs.removeEmpty?.checked ?? true
    };
  }

  function refresh() {
    if (!input || !output) return;
    if (input.value.length > MAX_INPUT) input.value = input.value.slice(0, MAX_INPUT);
    const r = removeDuplicates(input.value, readOptions());
    output.value = r.output;
    if (keptEl) keptEl.textContent = String(r.kept);
    if (removedEl) removedEl.textContent = String(r.removed);
    if (copyBtn) copyBtn.disabled = r.output === '';
  }

  input?.addEventListener('input', refresh);
  for (const el of Object.values(cbs)) el?.addEventListener('change', refresh);
  clearBtn?.addEventListener('click', () => { if (input) input.value = ''; refresh(); input?.focus(); });
  copyBtn?.addEventListener('click', async () => {
    if (!output || !output.value) return;
    const ok = await copyText(output.value);
    if (ok) toast('خروجی کپی شد', 'success'); else toast('کپی نشد', 'error');
  });
  refresh();
</script>

<style>
  .rd-tool { display: flex; flex-direction: column; gap: var(--space-3); }
  .rd-help { margin: 0; font-size: 0.8rem; color: var(--color-text-muted); }
  .rd-options { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-3); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface-2); margin: 0; }
  .rd-options legend { padding-inline: var(--space-2); font-size: 0.85rem; font-weight: 600; color: var(--color-text-muted); }
  .rd-opt { display: flex; align-items: center; gap: var(--space-2); cursor: pointer; font-size: 0.9rem; }
  .rd-opt input[type="checkbox"] { width: 18px; height: 18px; cursor: pointer; accent-color: var(--color-primary); }
  .rd-stats { display: flex; flex-wrap: wrap; gap: var(--space-3); padding: var(--space-2) var(--space-3); background: var(--color-surface-2); border-radius: var(--radius-md); border: 1px solid var(--color-border); font-size: 0.9rem; }
  .rd-stat strong { color: var(--color-primary); font-variant-numeric: tabular-nums; }
  .rd-actions { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .rd-output-label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-muted); margin-top: var(--space-2); }
  .rd-output { background: var(--color-surface-2); }
</style>

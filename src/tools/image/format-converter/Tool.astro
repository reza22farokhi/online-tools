---
---
<div class="fc-tool">
  <div class="fc-upload-zone" id="fc-upload-zone">
    <input type="file" id="fc-file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif,image/bmp" class="sr-only" />
    <label for="fc-file" class="fc-upload-label">
      <span class="fc-icon">🔄</span>
      <span data-lang-fa="برای انتخاب تصویر کلیک کنید یا آن را اینجا رها کنید" data-lang-en="Click to choose an image or drag it here">برای انتخاب تصویر کلیک کنید یا آن را اینجا رها کنید</span>
      <span class="fc-hint" data-lang-fa="حداکثر ۲۰ مگابایت (پردازش محلی)" data-lang-en="Maximum 20 MB (local processing)">حداکثر ۲۰ مگابایت (پردازش محلی)</span>
    </label>
  </div>
  <div class="fc-error" id="fc-error" hidden role="alert"></div>
  <div class="fc-workspace" id="fc-workspace" hidden>
    <div class="fc-preview-wrap">
      <img id="fc-preview" class="fc-preview" alt="Preview" />
      <div class="fc-file-info" id="fc-file-info"></div>
    </div>
    <div class="fc-controls">
      <div class="fc-field">
        <label for="fc-format" data-lang-fa="فرمت خروجی:" data-lang-en="Output format:">فرمت خروجی:</label>
        <select id="fc-format" class="select">
          <option value="image/jpeg" selected>JPG</option>
          <option value="image/png">PNG</option>
          <option value="image/webp">WebP</option>
        </select>
      </div>
      <div class="fc-actions">
        <button type="button" class="btn btn-primary" id="fc-process">✨ <span data-lang-fa="تبدیل فرمت" data-lang-en="Convert format">تبدیل فرمت</span></button>
        <a id="fc-download" class="btn" style="display: none;">📥 <span data-lang-fa="دانلود تصویر" data-lang-en="Download image">دانلود تصویر</span></a>
      </div>
    </div>
  </div>
</div>
<script>
  import { getFileExtension, formatBytes, validateFileSize, MAX_IMAGE_SIZE, MAX_IMAGE_SIZE_LABEL } from './logic';
  import type { ImageFormat } from './logic';
  const fileInput = document.getElementById('fc-file') as HTMLInputElement | null;
  const uploadZone = document.getElementById('fc-upload-zone');
  const workspace = document.getElementById('fc-workspace');
  const errorEl = document.getElementById('fc-error');
  const previewImg = document.getElementById('fc-preview') as HTMLImageElement | null;
  const fileInfo = document.getElementById('fc-file-info');
  const formatSelect = document.getElementById('fc-format') as HTMLSelectElement | null;
  const processBtn = document.getElementById('fc-process') as HTMLButtonElement | null;
  const downloadBtn = document.getElementById('fc-download') as HTMLAnchorElement | null;
  let originalImage: HTMLImageElement | null = null;
  let originalSize = 0;
  let originalWidth = 0;
  let originalHeight = 0;
  function renderFileInfo() {
    if (!fileInfo) return;
    const isEnglish = document.documentElement.lang === 'en';
    fileInfo.textContent = isEnglish
      ? `Original size: ${formatBytes(originalSize)} | Dimensions: ${originalWidth}×${originalHeight}`
      : `حجم اصلی: ${formatBytes(originalSize)} | ابعاد: ${originalWidth}×${originalHeight}`;
  }
  document.addEventListener('app:languagechange', renderFileInfo);
  let objectUrl: string | null = null;
  let isProcessing = false;
  let downloadUrl: string | null = null;
  const MAX_IMAGE_PIXELS = 16_000_000;
  const SUPPORTED_TYPES = ['image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/avif', 'image/bmp'];
  function showError(msg: string) {
    if (errorEl) { errorEl.hidden = false; errorEl.textContent = msg; }
    if (uploadZone) uploadZone.hidden = false;
    if (workspace) workspace.hidden = true;
    if (fileInput) fileInput.value = '';
    if (downloadBtn) downloadBtn.style.display = 'none';
    isProcessing = false;
  }
  function clearError() { if (errorEl) { errorEl.hidden = true; errorEl.textContent = ''; } }
  function showProcessError(msg: string) {
    if (errorEl) { errorEl.hidden = false; errorEl.textContent = msg; }
    if (workspace) workspace.hidden = false;
    if (uploadZone) uploadZone.hidden = true;
  }
  function handleFile(file: File) {
    clearError();
    if (isProcessing) { showError('یک پردازش در حال انجام است.'); return; }
    if (!SUPPORTED_TYPES.includes(file.type)) { showError('فرمت تصویر پشتیبانی نمی‌شود. JPG، PNG، WebP، GIF، AVIF یا BMP انتخاب کنید.'); return; }
    const v = validateFileSize(file.size, MAX_IMAGE_SIZE, MAX_IMAGE_SIZE_LABEL);
    if (!v.ok) { showError(v.error ?? 'خطای نامشخص'); return; }
    isProcessing = true;
    if (objectUrl) URL.revokeObjectURL(objectUrl);
    objectUrl = URL.createObjectURL(file);
    originalSize = file.size;
    const img = new Image();
    img.onload = () => {
      if (img.naturalWidth * img.naturalHeight > MAX_IMAGE_PIXELS) {
        if (objectUrl) URL.revokeObjectURL(objectUrl); objectUrl = null;
        showError('ابعاد تصویر بیش از حد مجاز است (حداکثر ۱۶ مگاپیکسل).');
        return;
      }
      originalImage = img;
      originalWidth = img.naturalWidth;
      originalHeight = img.naturalHeight;
      if (previewImg) previewImg.src = objectUrl!;
      renderFileInfo();
      if (uploadZone) uploadZone.hidden = true;
      if (workspace) workspace.hidden = false;
      if (downloadBtn) downloadBtn.style.display = 'none';
      isProcessing = false;
    };
    img.onerror = () => { if (objectUrl) URL.revokeObjectURL(objectUrl); objectUrl = null; showError('فایل تصویری معتبر نیست.'); };
    img.src = objectUrl;
  }
  fileInput?.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.files && t.files.length > 0) handleFile(t.files[0]);
  });
  uploadZone?.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.style.borderColor = 'var(--color-primary)'; });
  uploadZone?.addEventListener('dragleave', () => { uploadZone.style.borderColor = 'var(--color-border)'; });
  uploadZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadZone.style.borderColor = 'var(--color-border)';
    if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) handleFile(e.dataTransfer.files[0]);
  });
  processBtn?.addEventListener('click', () => {
    if (!originalImage || !formatSelect || !downloadBtn || !processBtn) return;
    clearError();
    const format = formatSelect.value as ImageFormat;
    processBtn.disabled = true;
    if (downloadUrl) URL.revokeObjectURL(downloadUrl);
    const canvas = document.createElement('canvas');
    canvas.width = originalImage.naturalWidth;
    canvas.height = originalImage.naturalHeight;
    const ctx = canvas.getContext('2d');
    if (!ctx) { processBtn.disabled = false; showProcessError('مرورگر از Canvas پشتیبانی نمی‌کند.'); return; }
    if (format === 'image/jpeg') {
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }
    ctx.drawImage(originalImage, 0, 0);
    canvas.toBlob((blob) => {
      processBtn.disabled = false;
      if (!blob) { showProcessError('ساخت تصویر خروجی ناموفق بود.'); return; }
      const url = URL.createObjectURL(blob);
      downloadUrl = url;
      downloadBtn.href = url;
      downloadBtn.download = `converted-image.${getFileExtension(format)}`;
      downloadBtn.style.display = 'inline-flex';
    }, format, 0.95);
  });
</script>
<style>
  .fc-tool { display: flex; flex-direction: column; gap: var(--space-4); }
  .fc-upload-zone { border: 2px dashed var(--color-border); border-radius: var(--radius-lg); padding: var(--space-6); text-align: center; transition: border-color 0.2s; background: var(--color-surface-2); }
  .fc-upload-label { display: flex; flex-direction: column; align-items: center; gap: var(--space-2); cursor: pointer; color: var(--color-text); }
  .fc-icon { font-size: 2.5rem; }
  .fc-hint { font-size: 0.8rem; color: var(--color-text-muted); }
  .fc-error { padding: var(--space-3); background: color-mix(in srgb, var(--color-danger) 12%, transparent); border: 1px solid var(--color-danger); border-radius: var(--radius-md); color: var(--color-danger); font-size: 0.9rem; }
  .fc-workspace { display: grid; grid-template-columns: 1fr; gap: var(--space-4); }
  @media (min-width: 768px) { .fc-workspace { grid-template-columns: 1fr 1fr; } }
  .fc-preview-wrap { display: flex; flex-direction: column; gap: var(--space-2); }
  .fc-preview { width: 100%; border-radius: var(--radius-md); border: 1px solid var(--color-border); background: repeating-conic-gradient(#f1f5f9 0% 25%, #e2e8f0 0% 50%) 50% / 20px 20px; max-height: 400px; object-fit: contain; }
  .fc-file-info { font-size: 0.85rem; color: var(--color-text-muted); text-align: center; }
  .fc-controls { display: flex; flex-direction: column; gap: var(--space-3); }
  .fc-field { display: flex; flex-direction: column; gap: var(--space-1); }
  .fc-field label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-muted); }
  .fc-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-2); }
  .fc-workspace[hidden] { display: none; }
</style>

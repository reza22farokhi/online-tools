---
// Tool UI
---
<div class="qr-tool">
  <div class="input-group">
    <label for="qr-input">متن یا لینک خود را وارد کنید:</label>
    <textarea id="qr-input" rows="3" placeholder="https://example.com"></textarea>
  </div>
  
  <div class="options-group">
    <label for="qr-size">اندازه تصویر (پیکسل):</label>
    <input type="number" id="qr-size" value="300" min="100" max="1000" step="50" />
  </div>

  <button id="generate-btn" class="btn-primary">تولید کد QR</button>

  <div id="qr-result" class="result-container hidden">
    <canvas id="qr-canvas"></canvas>
    <a id="download-btn" class="btn-secondary" download="qrcode.png">دانلود تصویر</a>
  </div>
</div>

<script>
  import QRCode from 'qrcode';

  const inputEl = document.getElementById('qr-input') as HTMLTextAreaElement;
  const sizeEl = document.getElementById('qr-size') as HTMLInputElement;
  const btnEl = document.getElementById('generate-btn') as HTMLButtonElement;
  const resultEl = document.getElementById('qr-result') as HTMLDivElement;
  const canvasEl = document.getElementById('qr-canvas') as HTMLCanvasElement;
  const downloadEl = document.getElementById('download-btn') as HTMLAnchorElement;

  if (btnEl && canvasEl && resultEl) {
    btnEl.addEventListener('click', async () => {
      const text = inputEl.value.trim();
      const size = parseInt(sizeEl.value, 10) || 300;

      if (!text) {
        alert('لطفاً متنی برای تبدیل وارد کنید.');
        return;
      }

      try {
        await QRCode.toCanvas(canvasEl, text, {
          width: size,
          margin: 2,
          color: {
            dark: '#000000',
            light: '#ffffff'
          }
        });
        
        // Prepare download link
        downloadEl.href = canvasEl.toDataURL('image/png');
        resultEl.classList.remove('hidden');
      } catch (err) {
        console.error(err);
        alert('خطایی در تولید کد QR رخ داد.');
      }
    });
  }
</script>

<style>
  .qr-tool {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 500px;
    margin: 0 auto;
  }
  .input-group, .options-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  label {
    font-weight: 600;
    font-size: 0.95rem;
  }
  textarea, input[type="number"] {
    width: 100%;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: inherit;
    background: var(--color-surface-2);
  }
  .btn-primary {
    background: var(--color-primary);
    color: white;
    padding: var(--space-2) var(--space-4);
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-weight: bold;
  }
  .btn-primary:hover {
    opacity: 0.9;
  }
  .result-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .hidden {
    display: none !important;
  }
  canvas {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .btn-secondary {
    background: var(--color-surface-2);
    color: var(--color-text);
    padding: var(--space-2) var(--space-4);
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }
  .btn-secondary:hover {
    background: var(--color-border);
  }
</style>

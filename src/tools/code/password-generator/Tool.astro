---
// Password Generator UI
---
<div class="pass-tool">
  <div class="output-group">
    <label for="pass-output" class="sr-only"><span data-lang-fa="رمز عبور تولیدشده" data-lang-en="Generated password">رمز عبور تولیدشده</span></label>
    <input type="text" id="pass-output" readonly autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="رمز عبور اینجا نمایش داده می‌شود" data-lang-placeholder-fa="رمز عبور اینجا نمایش داده می‌شود" data-lang-placeholder-en="Your password will appear here" dir="ltr" />
    <button id="copy-btn" class="btn-secondary" type="button" title="Copy password" aria-label="Copy password">📋</button>
  </div>

  <button id="generate-btn" class="btn-primary" type="button"><span data-lang-fa="تولید رمز عبور جدید" data-lang-en="Generate new password">تولید رمز عبور جدید</span></button>

  <div class="options">
    <div class="option-row">
      <label for="pass-length"><span data-lang-fa="طول رمز:" data-lang-en="Password length:">طول رمز:</span> <span id="length-val">16</span></label>
      <input type="range" id="pass-length" min="8" max="64" value="16" />
    </div>
    <div class="checkbox-group">
      <label><input type="checkbox" id="inc-upper" checked> <span data-lang-fa="شامل حروف بزرگ (A-Z)" data-lang-en="Include uppercase letters (A-Z)">شامل حروف بزرگ (A-Z)</span></label>
      <label><input type="checkbox" id="inc-lower" checked> <span data-lang-fa="شامل حروف کوچک (a-z)" data-lang-en="Include lowercase letters (a-z)">شامل حروف کوچک (a-z)</span></label>
      <label><input type="checkbox" id="inc-numbers" checked> <span data-lang-fa="شامل اعداد (0-9)" data-lang-en="Include numbers (0-9)">شامل اعداد (0-9)</span></label>
      <label><input type="checkbox" id="inc-symbols" checked> <span data-lang-fa="شامل نمادها (!@#$%)" data-lang-en="Include symbols (!@#$%)">شامل نمادها (!@#$%)</span></label>
    </div>
  </div>
</div>

<script>
  import { generatePassword } from './logic';
  import { copyText, toast } from '../../../lib/ui';

  const outputEl = document.getElementById('pass-output') as HTMLInputElement;
  const lengthEl = document.getElementById('pass-length') as HTMLInputElement;
  const lengthValEl = document.getElementById('length-val') as HTMLSpanElement;
  const generateBtn = document.getElementById('generate-btn') as HTMLButtonElement;
  const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;
  const incUpper = document.getElementById('inc-upper') as HTMLInputElement;
  const incLower = document.getElementById('inc-lower') as HTMLInputElement;
  const incNumbers = document.getElementById('inc-numbers') as HTMLInputElement;
  const incSymbols = document.getElementById('inc-symbols') as HTMLInputElement;
  let generationError = false;

  const isEnglish = () => document.documentElement.lang === 'en';

  function updatePassword() {
    try {
      const length = parseInt(lengthEl.value, 10);
      outputEl.value = generatePassword(length, {
        upper: incUpper.checked,
        lower: incLower.checked,
        numbers: incNumbers.checked,
        symbols: incSymbols.checked
      });
      generationError = false;
    } catch {
      generationError = true;
      outputEl.value = isEnglish() ? 'Select at least one character set.' : 'حداقل یک گزینه را انتخاب کنید!';
    }
    copyBtn.disabled = generationError;
  }

  lengthEl.addEventListener('input', () => {
    lengthValEl.textContent = lengthEl.value;
    updatePassword();
  });
  generateBtn.addEventListener('click', updatePassword);
  [incUpper, incLower, incNumbers, incSymbols].forEach(el => el.addEventListener('change', updatePassword));
  document.addEventListener('app:languagechange', () => { if (generationError) updatePassword(); });

  copyBtn.addEventListener('click', async () => {
    if (!outputEl.value || generationError) return;
    const ok = await copyText(outputEl.value);
    toast(
      ok ? (isEnglish() ? 'Password copied.' : 'رمز عبور کپی شد.')
         : (isEnglish() ? 'Could not copy the password.' : 'کپی رمز عبور انجام نشد.'),
      ok ? 'success' : 'error'
    );
  });
  updatePassword();
</script>

<style>
  .pass-tool { max-width: 600px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--space-4); }
  .output-group { display: flex; gap: var(--space-2); }
  .output-group input { flex: 1; padding: var(--space-3); font-size: 1.2rem; font-family: monospace; background: var(--color-surface-2); border: 2px solid var(--color-border); border-radius: var(--radius-md); text-align: center; letter-spacing: 1px; }
  .btn-primary { background: var(--color-primary); color: white; padding: var(--space-3); border: none; border-radius: var(--radius-md); cursor: pointer; font-weight: bold; font-size: 1.1rem; }
  .btn-secondary { background: var(--color-surface-2); border: 1px solid var(--color-border); padding: 0 var(--space-3); border-radius: var(--radius-md); cursor: pointer; font-size: 1.2rem; }
  .options { display: flex; flex-direction: column; gap: var(--space-3); background: var(--color-surface); padding: var(--space-4); border-radius: var(--radius-md); border: 1px solid var(--color-border); }
  .option-row { display: flex; flex-direction: column; gap: var(--space-1); }
  input[type="range"] { width: 100%; }
  .checkbox-group { display: grid; grid-template-columns: 1fr; gap: var(--space-2); }
  @media (min-width: 600px) { .checkbox-group { grid-template-columns: 1fr 1fr; } }
  .checkbox-group label { display: flex; align-items: center; gap: var(--space-2); cursor: pointer; }
</style>

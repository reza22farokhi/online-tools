---
---
<div class="jsv-tool">
  <div class="jsv-grid">
    <label for="jsv-data"><strong data-lang-fa="JSON داده" data-lang-en="JSON data">JSON داده</strong><textarea id="jsv-data" class="textarea jsv-area" rows="10" dir="ltr" spellcheck="false" placeholder='{"name":"Ada","age":36}'></textarea></label>
    <label for="jsv-schema"><strong data-lang-fa="JSON Schema" data-lang-en="JSON Schema">JSON Schema</strong><textarea id="jsv-schema" class="textarea jsv-area" rows="10" dir="ltr" spellcheck="false" placeholder='{"type":"object","required":["name"],"properties":{"name":{"type":"string"}}}'></textarea></label>
  </div>
  <div class="jsv-actions">
    <button type="button" class="btn btn-primary" id="jsv-validate" data-lang-fa="اعتبارسنجی" data-lang-en="Validate">اعتبارسنجی</button>
    <button type="button" class="btn" id="jsv-sample" data-lang-fa="نمونه آزمایشی" data-lang-en="Load sample">نمونه آزمایشی</button>
    <button type="button" class="btn" id="jsv-clear" data-lang-fa="پاک‌کردن" data-lang-en="Clear">پاک‌کردن</button>
  </div>
  <section id="jsv-result" class="jsv-result" aria-live="polite" hidden></section>
  <p class="jsv-note" data-lang-fa="پردازش کاملاً محلی است. این ابزار مجموعه‌ای از کلیدهای رایج JSON Schema را پشتیبانی می‌کند؛ جزئیات پشتیبانی در پرسش‌های متداول آمده است." data-lang-en="Processing is local. This tool supports a practical subset of common JSON Schema keywords; see the FAQ for supported features.">پردازش کاملاً محلی است. این ابزار مجموعه‌ای از کلیدهای رایج JSON Schema را پشتیبانی می‌کند؛ جزئیات پشتیبانی در پرسش‌های متداول آمده است.</p>
</div>
<script>
  import { validateJsonSchema } from './logic';
  const $ = (id: string) => document.getElementById(id);
  const data = $('jsv-data') as HTMLTextAreaElement;
  const schema = $('jsv-schema') as HTMLTextAreaElement;
  const result = $('jsv-result') as HTMLElement;
  const sampleData = JSON.stringify({ name: 'Ada', age: 36, tags: ['math', 'computing'] }, null, 2);
  const sampleSchema = JSON.stringify({ type: 'object', required: ['name', 'age'], additionalProperties: false, properties: { name: { type: 'string', minLength: 2 }, age: { type: 'integer', minimum: 0 }, tags: { type: 'array', items: { type: 'string' }, uniqueItems: true } } }, null, 2);
  function validate() {
    result.hidden = false;
    result.replaceChildren();
    try {
      const r = validateJsonSchema(data.value, schema.value);
      const heading = document.createElement('p');
      heading.className = r.valid ? 'jsv-pass' : 'jsv-fail';
      heading.textContent = r.valid ? (document.documentElement.lang === 'en' ? 'Valid: data matches the supported schema rules.' : 'معتبر: داده با قواعد پشتیبانی‌شده schema مطابقت دارد.') : (document.documentElement.lang === 'en' ? 'Invalid: ' + r.issues.length + ' issue(s) found.' : 'نامعتبر: ' + r.issues.length + ' مورد ناسازگاری پیدا شد.');
      result.append(heading);
      const count = document.createElement('p');
      count.textContent = (document.documentElement.lang === 'en' ? 'Validation checks: ' : 'تعداد بررسی‌ها: ') + r.checked;
      result.append(count);
      for (const issue of r.issues) {
        const item = document.createElement('p');
        item.className = 'jsv-issue';
        const path = document.createElement('code'); path.textContent = issue.path;
        const message = document.createElement('span'); message.textContent = issue.message;
        item.append(path, message); result.append(item);
      }
      if (!r.valid && r.issues.length === 100) {
        const note = document.createElement('p'); note.textContent = document.documentElement.lang === 'en' ? 'Output limited to the first 100 issues.' : 'نمایش خطاها به ۱۰۰ مورد اول محدود شده است.'; result.append(note);
      }
    } catch (e) {
      const msg = document.createElement('p'); msg.className = 'jsv-fail'; msg.textContent = e instanceof Error ? e.message : 'Validation failed'; result.append(msg);
    }
  }
  $('jsv-validate')?.addEventListener('click', validate);
  $('jsv-sample')?.addEventListener('click', () => { data.value = sampleData; schema.value = sampleSchema; validate(); });
  $('jsv-clear')?.addEventListener('click', () => { data.value = ''; schema.value = ''; result.replaceChildren(); result.hidden = true; data.focus(); });
  data.value = sampleData; schema.value = sampleSchema; validate();
</script>
<style>
  .jsv-tool{display:flex;flex-direction:column;gap:var(--space-3)}
  .jsv-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-3)}
  .jsv-grid label{display:flex;flex-direction:column;gap:var(--space-2);min-width:0}
  .jsv-area{font-family:var(--font-mono);font-size:.85rem;direction:ltr;text-align:left}
  .jsv-actions{display:flex;flex-wrap:wrap;gap:var(--space-2)}
  .jsv-result{padding:var(--space-3);border:1px solid var(--color-border);border-radius:var(--radius-md);overflow-wrap:anywhere}
  .jsv-result p{margin:.4rem 0}
  .jsv-pass{color:var(--color-success);font-weight:700}
  .jsv-fail{color:var(--color-danger);font-weight:700}
  .jsv-issue{display:flex;flex-wrap:wrap;gap:var(--space-2);padding:.4rem 0;border-top:1px solid var(--color-border)}
  .jsv-issue code{direction:ltr}
  .jsv-note{font-size:.82rem;color:var(--color-text-muted);margin:0}
  @media(max-width:700px){.jsv-grid{grid-template-columns:1fr}}
</style>

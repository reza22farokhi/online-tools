---
---
<div class="jf-tool">
  <label for="jf-input" class="sr-only"><span data-lang-fa="JSON ورودی" data-lang-en="Input JSON">JSON ورودی</span></label>
  <textarea id="jf-input" class="textarea jf-input" placeholder='{"name": "example", "items": [1, 2, 3]}' spellcheck="false" aria-describedby="jf-help"></textarea>
  <p id="jf-help" class="jf-help" data-lang-fa="JSON را جای‌گذاری کنید. حداکثر ۱۰۰ هزار کاراکتر. پردازش کاملاً محلی." data-lang-en="Paste JSON here. Maximum 100,000 characters. Processing stays entirely in your browser.">JSON را جای‌گذاری کنید. حداکثر ۱۰۰ هزار کاراکتر. پردازش کاملاً محلی.</p>
  <div class="jf-controls">
    <div class="jf-modes" role="group" aria-label="JSON operation">
      <button type="button" class="btn jf-mode active" data-mode="format" aria-pressed="true">Format</button>
      <button type="button" class="btn jf-mode" data-mode="minify" aria-pressed="false">Minify</button>
      <button type="button" class="btn jf-mode" data-mode="validate" aria-pressed="false">Validate</button>
    </div>
    <div class="jf-indent" id="jf-indent-wrap">
      <label for="jf-indent"><span data-lang-fa="تورفتگی:" data-lang-en="Indentation:">تورفتگی:</span></label>
      <select id="jf-indent" class="select jf-indent-select">
        <option value="2" selected>2 spaces</option>
        <option value="4">4 spaces</option>
      </select>
    </div>
  </div>
  <section class="jf-advanced" aria-label="Advanced JSON tools">
    <div class="jf-advanced-options">
      <strong data-lang-fa="پاک‌سازی و تبدیل پیشرفته" data-lang-en="Advanced cleanup and transforms">پاک‌سازی و تبدیل پیشرفته</strong>
      <label><input id="jf-sort-keys" type="checkbox"> <span data-lang-fa="مرتب‌سازی کلیدها" data-lang-en="Sort object keys">مرتب‌سازی کلیدها</span></label>
      <label><input id="jf-remove-nulls" type="checkbox"> <span data-lang-fa="حذف مقدارهای null" data-lang-en="Remove null values">حذف مقدارهای null</span></label>
      <label><input id="jf-remove-empty" type="checkbox"> <span data-lang-fa="حذف رشته و ساختارهای خالی" data-lang-en="Remove empty strings and containers">حذف رشته و ساختارهای خالی</span></label>
      <button type="button" class="btn" id="jf-transform"><span data-lang-fa="اعمال پاک‌سازی" data-lang-en="Apply cleanup">اعمال پاک‌سازی</span></button>
    </div>
    <div class="jf-path-tools">
      <strong data-lang-fa="کاوشگر JSONPath" data-lang-en="JSONPath explorer">کاوشگر JSONPath</strong>
      <label for="jf-path"><span data-lang-fa="مسیر داده" data-lang-en="Data path">مسیر داده</span></label>
      <div class="jf-path-row">
        <input id="jf-path" class="input" type="text" value="$" maxlength="500" placeholder="$.users[0].name" dir="ltr" spellcheck="false">
        <button type="button" class="btn btn-primary" id="jf-path-extract"><span data-lang-fa="استخراج مسیر" data-lang-en="Extract path">استخراج مسیر</span></button>
        <button type="button" class="btn" id="jf-path-copy" disabled><span data-lang-fa="کپی نتیجه" data-lang-en="Copy result">کپی نتیجه</span></button>
      </div>
      <p class="jf-help" data-lang-fa="نمونه: $.user.name ، $[&quot;odd-key&quot;] ، $.items[*].id. اجرای کد یا eval انجام نمی‌شود." data-lang-en="Examples: $.user.name, $[&quot;odd-key&quot;], $.items[*].id. No code execution or eval is used.">Examples: $.user.name, $[&quot;odd-key&quot;], $.items[*].id.</p>
      <p id="jf-path-error" class="jf-path-error" role="alert" hidden></p>
      <label for="jf-path-output"><span data-lang-fa="نتیجه مسیر" data-lang-en="Path result">نتیجه مسیر</span></label>
      <textarea id="jf-path-output" class="textarea jf-path-output" readonly spellcheck="false"></textarea>
    </div>
  </section>
  <div class="jf-error" id="jf-error" hidden role="alert"></div>
  <div class="jf-actions">
    <button type="button" class="btn" id="jf-clear"><span aria-hidden="true">🗑️</span> <span data-lang-fa="پاک کردن" data-lang-en="Clear">پاک کردن</span></button>
    <button type="button" class="btn btn-primary" id="jf-copy" disabled><span aria-hidden="true">📋</span> <span data-lang-fa="کپی خروجی" data-lang-en="Copy output">کپی خروجی</span></button>
  </div>
  <label for="jf-output" class="jf-output-label"><span data-lang-fa="خروجی:" data-lang-en="Output:">خروجی:</span></label>
  <textarea id="jf-output" class="textarea jf-output" readonly placeholder="پس از جای‌گذاری JSON، خروجی اینجا نمایش داده می‌شود..." data-lang-placeholder-fa="پس از جای‌گذاری JSON، خروجی اینجا نمایش داده می‌شود..." data-lang-placeholder-en="Formatted JSON will appear here..."></textarea>
</div>
<script>
  import { processJson, queryJsonPath, transformJson } from './logic';
  import type { JsonMode } from './logic';
  import { copyText, toast } from '../../../lib/ui';
  const MAX_INPUT = 100_000;
  const input = document.getElementById('jf-input') as HTMLTextAreaElement | null;
  const output = document.getElementById('jf-output') as HTMLTextAreaElement | null;
  const errorEl = document.getElementById('jf-error') as HTMLDivElement | null;
  const indentSelect = document.getElementById('jf-indent') as HTMLSelectElement | null;
  const indentWrap = document.getElementById('jf-indent-wrap') as HTMLDivElement | null;
  const clearBtn = document.getElementById('jf-clear') as HTMLButtonElement | null;
  const copyBtn = document.getElementById('jf-copy') as HTMLButtonElement | null;
  const modeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.jf-mode'));
  const sortKeys = document.getElementById('jf-sort-keys') as HTMLInputElement | null;
  const removeNulls = document.getElementById('jf-remove-nulls') as HTMLInputElement | null;
  const removeEmpty = document.getElementById('jf-remove-empty') as HTMLInputElement | null;
  const transformBtn = document.getElementById('jf-transform') as HTMLButtonElement | null;
  const pathInput = document.getElementById('jf-path') as HTMLInputElement | null;
  const pathOutput = document.getElementById('jf-path-output') as HTMLTextAreaElement | null;
  const pathError = document.getElementById('jf-path-error') as HTMLParagraphElement | null;
  const pathExtractBtn = document.getElementById('jf-path-extract') as HTMLButtonElement | null;
  const pathCopyBtn = document.getElementById('jf-path-copy') as HTMLButtonElement | null;
  let currentMode: JsonMode = 'format';
  let hasError = false;
  const isEnglish = () => document.documentElement.lang === 'en';
  function renderError() {
    if (!errorEl) return;
    errorEl.hidden = !hasError;
    errorEl.textContent = hasError ? (isEnglish() ? 'Invalid JSON. Check the syntax and try again.' : 'JSON نامعتبر است؛ ساختار و نشانه‌گذاری را بررسی کنید.') : '';
  }
  function refresh() {
    if (!input || !output) return;
    if (input.value.length > MAX_INPUT) input.value = input.value.slice(0, MAX_INPUT);
    if (!input.value.trim()) {
      hasError = false;
      renderError();
      output.value = '';
      if (copyBtn) copyBtn.disabled = true;
      if (indentWrap) indentWrap.style.display = currentMode === 'format' ? '' : 'none';
      return;
    }
    const indent: 2 | 4 = indentSelect?.value === '4' ? 4 : 2;
    if (indentWrap) indentWrap.style.display = currentMode === 'format' ? '' : 'none';
    const result = processJson(input.value, currentMode, indent);
    if (!result.ok) {
      hasError = true; renderError(); output.value = ''; if (copyBtn) copyBtn.disabled = true;
    } else {
      hasError = false; renderError(); output.value = result.output; if (copyBtn) copyBtn.disabled = result.output === '';
    }
  }
  input?.addEventListener('input', () => {
    if (pathOutput) pathOutput.value = '';
    if (pathError) { pathError.hidden = true; pathError.textContent = ''; }
    if (pathCopyBtn) pathCopyBtn.disabled = true;
    refresh();
  });
  indentSelect?.addEventListener('change', refresh);
  for (const btn of modeBtns) {
    btn.addEventListener('click', () => {
      for (const b of modeBtns) { b.classList.toggle('active', b === btn); b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); }
      currentMode = (btn.dataset.mode as JsonMode) || 'format'; refresh();
    });
  }
  clearBtn?.addEventListener('click', () => {
    if (input) input.value = '';
    if (pathOutput) pathOutput.value = '';
    if (pathError) { pathError.hidden = true; pathError.textContent = ''; }
    if (pathCopyBtn) pathCopyBtn.disabled = true;
    refresh();
    input?.focus();
  });

  transformBtn?.addEventListener('click', () => {
    if (!input || !output) return;
    const indent: 2 | 4 = indentSelect?.value === '4' ? 4 : 2;
    const result = transformJson(input.value, {
      sortKeys: Boolean(sortKeys?.checked),
      removeNulls: Boolean(removeNulls?.checked),
      removeEmpty: Boolean(removeEmpty?.checked)
    }, indent);
    if (!result.ok) {
      hasError = true;
      renderError();
      if (errorEl) errorEl.textContent = result.error || (isEnglish() ? 'Could not transform JSON.' : 'تبدیل JSON ناموفق بود.');
      if (copyBtn) copyBtn.disabled = true;
      return;
    }
    hasError = false;
    renderError();
    output.value = result.output;
    if (copyBtn) copyBtn.disabled = result.output === '';
  });

  pathExtractBtn?.addEventListener('click', () => {
    if (!input || !pathInput || !pathOutput) return;
    const indent: 2 | 4 = indentSelect?.value === '4' ? 4 : 2;
    const result = queryJsonPath(input.value, pathInput.value, indent);
    if (pathError) {
      pathError.hidden = result.ok;
      pathError.textContent = result.ok ? '' : result.error || '';
    }
    pathOutput.value = result.ok ? result.output : '';
    if (pathCopyBtn) pathCopyBtn.disabled = !result.ok || result.output === '';
  });

  pathCopyBtn?.addEventListener('click', async () => {
    if (!pathOutput?.value) return;
    const ok = await copyText(pathOutput.value);
    toast(ok ? (isEnglish() ? 'Path result copied.' : 'نتیجه مسیر کپی شد') : (isEnglish() ? 'Copy failed.' : 'کپی نشد'), ok ? 'success' : 'error');
  });
  copyBtn?.addEventListener('click', async () => {
    if (!output || !output.value) return;
    const ok = await copyText(output.value);
    toast(ok ? (isEnglish() ? 'Output copied.' : 'خروجی کپی شد') : (isEnglish() ? 'Copy failed.' : 'کپی نشد'), ok ? 'success' : 'error');
  });
  document.addEventListener('app:languagechange', renderError);
  refresh();
</script>
<style>
  .jf-tool { display: flex; flex-direction: column; gap: var(--space-3); }
  .jf-help { margin: 0; font-size: 0.8rem; color: var(--color-text-muted); }
  .jf-controls { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; justify-content: space-between; }
  .jf-modes { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .jf-mode { font-size: 0.9rem; padding: var(--space-1) var(--space-3); }
  .jf-mode.active { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-primary-fg); }
  .jf-indent { display: flex; align-items: center; gap: var(--space-2); font-size: 0.9rem; color: var(--color-text-muted); }
  .jf-indent-select { width: auto; min-width: 110px; padding-block: var(--space-1); }
  .jf-error { padding: var(--space-2) var(--space-3); background: color-mix(in srgb, var(--color-danger) 12%, transparent); border: 1px solid var(--color-danger); border-radius: var(--radius-md); color: var(--color-danger); font-size: 0.9rem; font-family: var(--font-mono); word-break: break-word; }
  .jf-actions { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .jf-output-label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-muted); margin-top: var(--space-2); }
  .jf-output { background: var(--color-surface-2); }
  .jf-advanced { display:flex; flex-direction:column; gap:var(--space-3); padding:var(--space-3); border:1px solid var(--color-border); border-radius:var(--radius-md); }
  .jf-advanced-options { display:flex; flex-wrap:wrap; align-items:center; gap:var(--space-3); }
  .jf-advanced-options label { display:inline-flex; align-items:center; gap:var(--space-1); font-size:.9rem; }
  .jf-path-tools { display:flex; flex-direction:column; gap:var(--space-2); }
  .jf-path-row { display:flex; flex-wrap:wrap; gap:var(--space-2); }
  .jf-path-row .input { flex:1 1 14rem; min-width:0; direction:ltr; text-align:left; }
  .jf-path-output { min-height:7rem; font-family:var(--font-mono); direction:ltr; text-align:left; }
  .jf-path-error { margin:0; color:var(--color-danger); font-size:.85rem; }
  @media(max-width:480px){ .jf-advanced-options { align-items:flex-start; flex-direction:column; } .jf-path-row > button { flex:1 1 auto; } }
</style>

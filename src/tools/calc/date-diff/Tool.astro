---
---
<div class="dd-tool">
  <div class="dd-fields">
    <div class="dd-field">
      <label for="dd-from">از تاریخ</label>
      <input id="dd-from" type="date" class="input" />
    </div>
    <div class="dd-field">
      <label for="dd-to">تا تاریخ</label>
      <input id="dd-to" type="date" class="input" />
    </div>
  </div>
  <div class="dd-error" id="dd-error" hidden role="alert"></div>
  <div class="dd-results" id="dd-results" hidden>
    <div class="dd-main" id="dd-main">—</div>
    <div class="dd-grid">
      <div class="dd-cell"><span class="dd-num" id="dd-total-days">0</span><span class="dd-lbl">کل روزها</span></div>
      <div class="dd-cell"><span class="dd-num" id="dd-total-weeks">0</span><span class="dd-lbl">کل هفته‌ها</span></div>
      <div class="dd-cell"><span class="dd-num" id="dd-total-hours">0</span><span class="dd-lbl">کل ساعت‌ها</span></div>
      <div class="dd-cell"><span class="dd-num" id="dd-total-minutes">0</span><span class="dd-lbl">کل دقیقه‌ها</span></div>
      <div class="dd-cell dd-cell-green"><span class="dd-num" id="dd-business">0</span><span class="dd-lbl">روزهای کاری</span></div>
      <div class="dd-cell dd-cell-orange"><span class="dd-num" id="dd-weekend">0</span><span class="dd-lbl">روزهای تعطیل</span></div>
    </div>
  </div>
</div>

<script>
  import { calculateDateDiff, parseIsoDate } from './logic';
  const fromInput = document.getElementById('dd-from') as HTMLInputElement | null;
  const toInput = document.getElementById('dd-to') as HTMLInputElement | null;
  const errorEl = document.getElementById('dd-error') as HTMLDivElement | null;
  const resultsEl = document.getElementById('dd-results') as HTMLDivElement | null;
  const mainEl = document.getElementById('dd-main');
  const nums = {
    totalDays: document.getElementById('dd-total-days'),
    totalWeeks: document.getElementById('dd-total-weeks'),
    totalHours: document.getElementById('dd-total-hours'),
    totalMinutes: document.getElementById('dd-total-minutes'),
    business: document.getElementById('dd-business'),
    weekend: document.getElementById('dd-weekend')
  };

  function setHidden(el: HTMLElement | null, hidden: boolean) {
    if (el) el.hidden = hidden;
  }

  function refresh() {
    if (!fromInput || !toInput || !resultsEl) return;
    setHidden(errorEl, true);
    if (errorEl) errorEl.textContent = '';

    if (!fromInput.value || !toInput.value) {
      setHidden(resultsEl, true);
      return;
    }

    const from = parseIsoDate(fromInput.value);
    const to = parseIsoDate(toInput.value);
    if (!from || !to) {
      setHidden(resultsEl, true);
      if (errorEl) { errorEl.hidden = false; errorEl.textContent = 'تاریخ نامعتبر است'; }
      return;
    }

    const r = calculateDateDiff(from, to);
    if (!r) {
      setHidden(resultsEl, true);
      if (errorEl) { errorEl.hidden = false; errorEl.textContent = 'خطا در محاسبه'; }
      return;
    }

    setHidden(resultsEl, false);
    if (mainEl) {
      const parts: string[] = [];
      if (r.years > 0) parts.push(`${r.years} سال`);
      if (r.months > 0) parts.push(`${r.months} ماه`);
      parts.push(`${r.days} روز`);
      mainEl.textContent = parts.join(' و ');
    }
    if (nums.totalDays) nums.totalDays.textContent = r.totalDays.toLocaleString('fa-IR');
    if (nums.totalWeeks) nums.totalWeeks.textContent = r.totalWeeks.toLocaleString('fa-IR');
    if (nums.totalHours) nums.totalHours.textContent = r.totalHours.toLocaleString('fa-IR');
    if (nums.totalMinutes) nums.totalMinutes.textContent = r.totalMinutes.toLocaleString('fa-IR');
    if (nums.business) nums.business.textContent = r.businessDays.toLocaleString('fa-IR');
    if (nums.weekend) nums.weekend.textContent = r.weekendDays.toLocaleString('fa-IR');
  }

  fromInput?.addEventListener('change', refresh);
  fromInput?.addEventListener('input', refresh);
  toInput?.addEventListener('change', refresh);
  toInput?.addEventListener('input', refresh);
  refresh();
</script>

<style>
  .dd-tool { display: flex; flex-direction: column; gap: var(--space-4); }
  .dd-fields { display: grid; grid-template-columns: 1fr; gap: var(--space-3); }
  @media (min-width: 640px) { .dd-fields { grid-template-columns: 1fr 1fr; } }
  .dd-field { display: flex; flex-direction: column; gap: var(--space-1); }
  .dd-field label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-muted); }
  .dd-error { padding: var(--space-2) var(--space-3); background: color-mix(in srgb, var(--color-danger) 12%, transparent); border: 1px solid var(--color-danger); border-radius: var(--radius-md); color: var(--color-danger); font-size: 0.9rem; }
  .dd-results { display: flex; flex-direction: column; gap: var(--space-3); }
  .dd-main { padding: var(--space-3); background: color-mix(in srgb, var(--color-primary) 8%, transparent); border: 1px solid var(--color-primary); border-radius: var(--radius-md); font-size: 1.15rem; font-weight: 700; text-align: center; }
  .dd-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-2); }
  @media (min-width: 640px) { .dd-grid { grid-template-columns: repeat(3, 1fr); } }
  .dd-cell { display: flex; flex-direction: column; align-items: center; text-align: center; padding: var(--space-2); background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .dd-cell-green { background: color-mix(in srgb, var(--color-success) 10%, var(--color-surface-2)); }
  .dd-cell-orange { background: color-mix(in srgb, var(--color-warning) 10%, var(--color-surface-2)); }
  .dd-num { font-size: 1.25rem; font-weight: 700; color: var(--color-primary); font-variant-numeric: tabular-nums; }
  .dd-lbl { font-size: 0.8rem; color: var(--color-text-muted); margin-top: 2px; }
</style>

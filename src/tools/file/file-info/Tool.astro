---
---
<div class="fi-tool">
  <div class="fi-upload-zone" id="fi-upload-zone">
    <input type="file" id="fi-file" class="sr-only" />
    <label for="fi-file" class="fi-upload-label">
      <span class="fi-icon">📁</span>
      <span data-lang-fa="برای انتخاب فایل کلیک کنید یا آن را اینجا رها کنید" data-lang-en="Click to choose a file or drop it here">برای انتخاب فایل کلیک کنید یا آن را اینجا رها کنید</span>
      <span class="fi-hint" data-lang-fa="حداکثر حجم: ۵۰ مگابایت (پردازش محلی)" data-lang-en="Maximum size: 50 MB (processed locally)">حداکثر حجم: ۵۰ مگابایت (پردازش محلی)</span>
    </label>
  </div>
  <div class="fi-error" id="fi-error" hidden role="alert"></div>
  <div class="fi-workspace" id="fi-workspace" hidden>
    <div class="fi-grid">
      <div class="fi-card"><div class="fi-label" data-lang-fa="نام فایل" data-lang-en="File name">نام فایل</div><div class="fi-val" id="fi-name" data-user-content="true">-</div></div>
      <div class="fi-card"><div class="fi-label" data-lang-fa="حجم" data-lang-en="Size">حجم</div><div class="fi-val" id="fi-size">-</div></div>
      <div class="fi-card"><div class="fi-label" data-lang-fa="نوع (MIME)" data-lang-en="Type (MIME)">نوع (MIME)</div><div class="fi-val" id="fi-type" dir="ltr">-</div></div>
      <div class="fi-card"><div class="fi-label" data-lang-fa="پسوند" data-lang-en="Extension">پسوند</div><div class="fi-val" id="fi-ext">-</div></div>
    </div>
    <div class="fi-hash-wrap">
      <div class="fi-label" data-lang-fa="هش SHA-256:" data-lang-en="SHA-256 hash:">هش SHA-256:</div>
      <textarea id="fi-hash" class="textarea fi-hash" readonly rows="2" placeholder="در حال محاسبه..." data-lang-placeholder-fa="در حال محاسبه..." data-lang-placeholder-en="Calculating..."></textarea>
      <button type="button" class="btn" id="fi-copy-hash" disabled>📋 <span data-lang-fa="کپی هش" data-lang-en="Copy hash">کپی هش</span></button>
    </div>
  </div>
</div>
<script>
  import { formatBytes, calculateFileSha256, validateFileSize } from './logic';
  import { copyText, toast } from '../../../lib/ui';

  const fileInput = document.getElementById('fi-file') as HTMLInputElement | null;
  const uploadZone = document.getElementById('fi-upload-zone');
  const workspace = document.getElementById('fi-workspace');
  const errorEl = document.getElementById('fi-error');
  const nameEl = document.getElementById('fi-name');
  const sizeEl = document.getElementById('fi-size');
  const typeEl = document.getElementById('fi-type');
  const extEl = document.getElementById('fi-ext');
  const hashEl = document.getElementById('fi-hash') as HTMLTextAreaElement | null;
  const copyBtn = document.getElementById('fi-copy-hash') as HTMLButtonElement | null;

  const t = (fa: string, en: string) => document.documentElement.lang === 'en' ? en : fa;
  let isProcessing = false;
  let currentFile: File | null = null;
  function renderFileInfo(file: File) {
    const isEnglish = document.documentElement.lang === 'en';
    if (nameEl) nameEl.textContent = file.name;
    if (sizeEl) sizeEl.textContent = formatBytes(file.size);
    if (typeEl) typeEl.textContent = file.type || (isEnglish ? 'Unknown' : 'نامشخص');
    const parts = file.name.split('.');
    const ext = parts.length > 1 ? parts.pop()!.toUpperCase() : (isEnglish ? 'Unknown' : 'نامشخص');
    if (extEl) extEl.textContent = ext;
  }
  document.addEventListener('app:languagechange', () => { if (currentFile) renderFileInfo(currentFile); });

  function localizeFileError(message: string): string {
    if (document.documentElement.lang !== 'en') return message;
    const exact: Record<string, string> = {
      'اندازه فایل نامعتبر است.': 'The file size is invalid.',
      'فایل خالی است و قابل پردازش نیست.': 'The file is empty and cannot be processed.'
    };
    if (exact[message]) return exact[message];
    const tooLarge = message.match(/^حجم فایل \((.+) مگابایت\) بیشتر از حد مجاز ۵۰ مگابایت است\. لطفاً فایل کوچک‌تری انتخاب کنید\.$/);
    if (tooLarge) return `File size (${tooLarge[1]} MB) exceeds the 50 MB limit. Please choose a smaller file.`;
    return message;
  }

  function showError(msg: string) {
    if (errorEl) { errorEl.hidden = false; errorEl.textContent = localizeFileError(msg); }
    if (uploadZone) uploadZone.hidden = false;
    if (workspace) workspace.hidden = true;
    if (fileInput) fileInput.value = '';
    if (copyBtn) copyBtn.disabled = true;
    isProcessing = false;
  }
  function clearError() {
    if (errorEl) { errorEl.hidden = true; errorEl.textContent = ''; }
  }

  async function handleFile(file: File) {
    clearError();
    if (isProcessing) {
      showError(t('یک پردازش در حال انجام است. لطفاً کمی صبر کنید.', 'A file is already being processed. Please wait.'));
      return;
    }
    const validation = validateFileSize(file.size);
    if (!validation.ok) {
      showError(validation.error ?? t('خطای نامشخص در فایل.', 'Unknown file error.'));
      return;
    }
    isProcessing = true;
    if (uploadZone) uploadZone.hidden = true;
    if (workspace) workspace.hidden = false;
    if (copyBtn) copyBtn.disabled = true;
    currentFile = file;
    renderFileInfo(file);
    if (hashEl) hashEl.value = t('در حال محاسبه هش...', 'Calculating hash...');
    try {
      const hash = await calculateFileSha256(file);
      if (hashEl) hashEl.value = hash;
      if (copyBtn) copyBtn.disabled = false;
    } catch (e) {
      showError(t('خطا در محاسبه هش: ', 'Hash calculation failed: ') + (e instanceof Error ? e.message : t('نامشخص', 'Unknown')));
    } finally {
      isProcessing = false;
    }
  }

  fileInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files.length > 0) handleFile(target.files[0]);
  });
  uploadZone?.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.style.borderColor = 'var(--color-primary)'; });
  uploadZone?.addEventListener('dragleave', () => { uploadZone.style.borderColor = 'var(--color-border)'; });
  uploadZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadZone.style.borderColor = 'var(--color-border)';
    if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) handleFile(e.dataTransfer.files[0]);
  });
  copyBtn?.addEventListener('click', async () => {
    if (!hashEl?.value) return;
    const ok = await copyText(hashEl.value);
    if (ok) toast(t('هش کپی شد', 'Hash copied'), 'success'); else toast(t('کپی نشد', 'Copy failed'), 'error');
  });
</script>
<style>
  .fi-tool { display: flex; flex-direction: column; gap: var(--space-4); }
  .fi-upload-zone { border: 2px dashed var(--color-border); border-radius: var(--radius-lg); padding: var(--space-6); text-align: center; transition: border-color 0.2s; background: var(--color-surface-2); }
  .fi-upload-label { display: flex; flex-direction: column; align-items: center; gap: var(--space-2); cursor: pointer; color: var(--color-text); }
  .fi-icon { font-size: 2.5rem; }
  .fi-hint { font-size: 0.8rem; color: var(--color-text-muted); }
  .fi-error { padding: var(--space-3); background: color-mix(in srgb, var(--color-danger) 12%, transparent); border: 1px solid var(--color-danger); border-radius: var(--radius-md); color: var(--color-danger); font-size: 0.9rem; line-height: 1.6; }
  .fi-workspace { display: flex; flex-direction: column; gap: var(--space-4); }
  .fi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  @media (min-width: 640px) { .fi-grid { grid-template-columns: repeat(4, 1fr); } }
  .fi-card { background: var(--color-surface-2); padding: var(--space-3); border-radius: var(--radius-md); border: 1px solid var(--color-border); text-align: center; }
  .fi-label { font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: 4px; font-weight: 600; }
  .fi-val { font-size: 0.95rem; font-weight: 700; word-break: break-all; color: var(--color-text); }
  .fi-hash-wrap { display: flex; flex-direction: column; gap: var(--space-2); background: var(--color-surface-2); padding: var(--space-3); border-radius: var(--radius-md); border: 1px solid var(--color-border); }
  .fi-hash { font-family: var(--font-mono); font-size: 0.85rem; background: var(--color-surface); word-break: break-all; }
</style>
